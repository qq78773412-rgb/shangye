<view class="waterfalls-box data-v-2b54d857" style="{{'height:'+(height+'px')+';'}}"><block tt:for="{{list}}" tt:for-item="item" tt:for-index="index" tt:key="idKey"><view class="waterfalls-list data-v-2b54d857 vue-ref-in-for" style="{{'--offset:'+(offset+'px')+';'+('--cols:'+(cols)+';')+('top:'+(allPositionArr[index]?allPositionArr[index].top:0)+';')+('left:'+(allPositionArr[index]?allPositionArr[index].left:0)+';')}}" id="{{'waterfalls-list-id-'+item[idKey]}}" data-url="{{'/pagesExt/article/detail?id='+item[idKey]}}" data-ref="{{'waterfalls-list-id-'+item[idKey]}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" bindtap="__e"><image class="waterfalls-list-image data-v-2b54d857" style="{{(imageStyle)}}" mode="widthFix" src="{{item[imageSrcKey]||' '}}" data-event-opts="{{[['load',[['imageLoadHandle',[index]]]],['error',[['imageLoadHandle',[index]]]]]}}" bindload="__e" binderror="__e"></image><view class="article-waterfall-info data-v-2b54d857"><view class="p1 data-v-2b54d857">{{item.name}}</view><block tt:if="{{item.po_status&&item.po_status==1}}"><block class="data-v-2b54d857"><block tt:if="{{item.po_name}}"><view class="p3 data-v-2b54d857" style="{{(set.title_size&&set.title_size>0?'font-size:'+set.title_size*2+'rpx':'')}}">{{''+item.po_name+" "+item.po_content+''}}</view></block></block></block><block tt:if="{{item.pt_status&&item.pt_status==1}}"><block class="data-v-2b54d857"><block tt:if="{{item.pt_name}}"><view class="p3 data-v-2b54d857" style="{{(set.title_size&&set.title_size>0?'font-size:'+set.title_size*2+'rpx':'')}}">{{''+item.pt_name+" "+item.pt_content+''}}</view></block></block></block><block tt:if="{{item.pth_status&&item.pth_status==1}}"><block class="data-v-2b54d857"><block tt:if="{{item.pth_name}}"><view class="p3 data-v-2b54d857" style="{{(set.title_size&&set.title_size>0?'font-size:'+set.title_size*2+'rpx':'')}}">{{''+item.pth_name+" "+item.pth_content+''}}</view></block></block></block><block tt:if="{{item.pf_status&&item.pf_status==1}}"><block class="data-v-2b54d857"><block tt:if="{{item.pf_name}}"><view class="p3 data-v-2b54d857" style="{{(set.title_size&&set.title_size>0?'font-size:'+set.title_size*2+'rpx':'')}}">{{''+item.pf_name+" "+item.pf_content+''}}</view></block></block></block><view class="p2 data-v-2b54d857"><block tt:if="{{showtime=='1'}}"><text class="flex1 data-v-2b54d857" style="overflow:hidden;">{{item.createtime}}</text></block><block tt:if="{{showreadcount=='1'}}"><text style="overflow:hidden;" class="data-v-2b54d857">{{"阅读 "+item.readcount}}</text></block></view></view></view></block></view>