<view class="container"><block tt:if="{{isload}}"><block><view class="content"><block tt:for="{{$root.l0}}" tt:for-item="item" tt:for-index="index" tt:key="index"><block><view class="item"><view class="f1" style="width:100%;"><view class="t1">{{item.$orig.proname}}</view><block tt:if="{{item.$orig.status>=0}}"><block><block tt:if="{{item.$orig.allmoney||item.$orig.allscore||item.$orig.allcommission}}"><view style="line-height:50rpx;"><block tt:if="{{item.$orig.status==1}}"><text class="t1">返现：</text></block><block tt:if="{{item.$orig.status==0}}"><text class="t1">预估返现：</text></block><block tt:if="{{item.$orig.allmoney>0}}"><block><text class="t1">{{item.$orig.allmoney+item.m0}}</text></block></block><block tt:if="{{item.$orig.allscore>0}}"><block><text class="t1" style="margin-left:10rpx;">{{item.$orig.allscore+item.m1}}</text></block></block><block tt:if="{{item.$orig.allcommission>0}}"><block><text class="t1" style="margin-left:10rpx;">{{item.$orig.allcommission+item.m2}}</text></block></block></view></block><block tt:else><view style="line-height:50rpx;"><block tt:if="{{item.$orig.status==1}}"><text class="t1">返现：</text></block><block tt:if="{{item.$orig.status==0}}"><text class="t1">预估返现：</text></block><block><text class="t1">{{"0"+item.m3}}</text></block><block><text class="t1" style="margin-left:10rpx;">{{"0"+item.m4}}</text></block><block><text class="t1" style="margin-left:10rpx;">{{"0"+item.m5}}</text></block></view></block></block></block><block tt:if="{{item.$orig.create_time}}"><text class="t2">{{item.$orig.create_time}}</text></block><block tt:if="{{item.$orig.tipinfor}}"><text class="t2" style="color:#ff8758;">{{item.$orig.tipinfor}}</text></block></view><view class="f2" style="width:120rpx;flex:unset;"><block tt:if="{{item.$orig.status==1}}"><text class="t1">已发放</text></block><block tt:if="{{item.$orig.status==0}}"><text class="t1" style="color:red;">未发放</text></block><block tt:if="{{item.$orig.status==-1}}"><text class="t1" style="color:#999;">已失效</text></block></view></view></block></block></view><block tt:if="{{nodata}}"><nodata vue-id="5fb56f53-1" bind:__l="__l"></nodata></block><block tt:if="{{nomore}}"><nomore vue-id="5fb56f53-2" bind:__l="__l"></nomore></block></block></block><block tt:if="{{loading}}"><loading vue-id="5fb56f53-3" bind:__l="__l"></loading></block><dp-tabbar vue-id="5fb56f53-4" opt="{{opt}}" bind:__l="__l"></dp-tabbar><popmsg class="vue-ref" vue-id="5fb56f53-5" data-ref="popmsg" bind:__l="__l"></popmsg></view>