<view class="container"><block a:if="{{isload}}"><block><view class="tongji flex-y-center " style="{{'background:'+(color1?color1:$root.m0)+';'}}"><view><view class="price">{{set.give_money}}</view><view>累计奖励</view></view><view><view class="price">{{set.sy_money}}</view><view>排队中</view></view></view><view class="tab tab_top"><dd-tab vue-id="97f46c00-1" itemdata="{{['排队中','已完成']}}" itemst="{{['0','1']}}" st="{{st}}" data-event-opts="{{[['^changetab',[['changetab']]]]}}" onChangetab="__e" onVueInit="__l"></dd-tab></view><view class="height130"></view><view class="order-content "><block a:for="{{$root.l0}}" a:for-item="item" a:for-index="index" a:key="index"><view class="order-box"><view class="head"><view class="f1">{{"订单号："+item.$orig.ordernum}}</view><view class="flex1"></view><text class="st0">{{item.$orig.statusLabel}}</text></view><view class="content" style="border-bottom:none;"><view class="detail"><text class="t1">{{"商户名称："+item.$orig.bname}}</text></view><block a:if="{{item.$orig.title}}"><view class="detail">排队名称：<text class="t1" style="{{('color:'+item.m1)}}">{{item.$orig.title}}</text></view></block><view class="detail">排队金额：<text class="t1" style="{{('color:'+$root.m2)}}">{{item.$orig.money}}</text></view><block a:if="{{item.$orig.addup_money>0&&set.back_money_type==1}}"><view class="detail">路上金额：<text class="t1" style="{{('color:'+item.m3)}}">正在路上</text></view></block><block a:if="{{!set.back_money_type||set.back_money_type&&item.$orig.status==1}}"><view class="detail">已获金额：<text class="t1" style="{{('color:'+item.m4)}}">{{item.$orig.money_give}}</text></view></block><block a:if="{{item.$orig.queue_no}}"><view class="detail">当前排名：<text class="t1" style="{{('color:'+item.m5)}}">{{item.$orig.queue_noLabel}}</text></view></block><view class="detail"><text class="t1">{{"排队时间："+item.$orig.createtimeFormat}}</text></view></view><view class="operate flex-y-center flex-x-bottom "><block a:if="{{item.$orig.status==0&&set.quit_wxhb==1&&item.$orig.money_quit_hb>0}}"><view class="button" data-money="{{item.$orig.money_quit_hb}}" data-id="{{item.$orig.id}}" data-index="{{index}}" data-event-opts="{{[['tap',[['quitWithHb',['$event']]]]]}}" catchTap="__e">退出排队抽红包</view></block><block a:if="{{item.$orig.status==0&&set.quit_score==1&&item.$orig.give_score>0}}"><view class="button" style="{{'background:'+(item.m6)+';'+('color:'+('#fff')+';')+('border:'+('none')+';')}}" data-id="{{item.$orig.id}}" data-givescore="{{item.$orig.give_score}}" data-index="{{index}}" data-event-opts="{{[['tap',[['quitScore',['$event']]]]]}}" catchTap="__e">{{"退出返"+item.m7}}</view></block><block a:if="{{item.$orig.status==0&&set.quit_random_score==1}}"><view class="button" style="{{'background:'+(item.m8)+';'+('color:'+('#fff')+';')+('border:'+('none')+';')}}" data-money="{{item.$orig.money_quit_hb}}" data-id="{{item.$orig.id}}" data-index="{{index}}" data-event-opts="{{[['tap',[['quitRandomScore',['$event']]]]]}}" catchTap="__e">{{"退出排队抽"+item.m9}}</view></block></view></view></block></view><block a:if="{{nomore}}"><nomore vue-id="97f46c00-2" onVueInit="__l"></nomore></block><block a:if="{{nodata}}"><nodata vue-id="97f46c00-3" onVueInit="__l"></nodata></block></block></block><block a:if="{{prizeVisible}}"><view data-event-opts="{{[['touchMove',[['e0',['$event']]]],['mousewheel',[['',['$event']]]]]}}" class="page-view-hongbao" catchTouchMove="__e" onMousewheel="__e"><view class="hongbao-view"><view class="wrap"><view data-event-opts="{{[['tap',[['receive',['$event']]]]]}}" class="envelope" onTap="__e"><image class="cover" src="{{pre_url+'/static/img/envelope.png'}}" mode="aspectFill"></image><image class="btn" src="{{pre_url+'/static/img/btn.png'}}" mode="aspectFill"></image></view></view><view class="wrap"><view data-event-opts="{{[['tap',[['receive',['$event']]]]]}}" class="envelope" onTap="__e"><image class="cover" src="{{pre_url+'/static/img/envelope.png'}}" mode="aspectFill"></image><image class="btn" src="{{pre_url+'/static/img/btn.png'}}" mode="aspectFill"></image></view></view><view class="wrap"><view data-event-opts="{{[['tap',[['receive',['$event']]]]]}}" class="envelope" onTap="__e"><image class="cover" src="{{pre_url+'/static/img/envelope.png'}}" mode="aspectFill"></image><image class="btn" src="{{pre_url+'/static/img/btn.png'}}" mode="aspectFill"></image></view></view><view data-event-opts="{{[['tap',[['hbclose',['$event']]]]]}}" class="hongbao-view-close" onTap="__e"><image src="{{pre_url+'/static/img/close2.png'}}"></image></view></view><uni-popup onChange="__e" vue-id="97f46c00-4" ref="__r" data-ref="popup" data-event-opts="{{[['^change',[['']]]]}}" onVueInit="__l"><view class="cl-popup"><view class="main"><image class="top" src="{{pre_url+'/static/img/popup-top.png'}}" mode="aspectFill"></image><image class="icon" src="{{pre_url+'/static/img/popup-icon.png'}}" mode="aspectFill"></image><image class="bottom" src="{{pre_url+'/static/img/popup-bottom.png'}}" mode="aspectFill"></image><view class="content"><view class="price"><text class="num">{{hbmoney}}</text><text class="unit">元</text></view><view class="title">{{''+hbtext+''}}</view><view data-event-opts="{{[['tap',[['hbsuccess',['$event']]]]]}}" class="cl-button" onTap="__e"><text>确定</text></view></view></view></view></uni-popup></view></block><block a:if="{{randomScoreVisible}}"><view data-event-opts="{{[['touchMove',[['e1',['$event']]]],['mousewheel',[['',['$event']]]]]}}" class="page-view-hongbao" catchTouchMove="__e" onMousewheel="__e"><view class="hongbao-view" style="top:15%;"><view class="wrap" style="width:33%;height:310rpx;" a:for="{{3}}" a:for-item="item" a:for-index="index"><view data-event-opts="{{[['tap',[['receiveRandomScore',['$event']]]]]}}" class="envelope" onTap="__e"><image class="cover" src="{{pre_url+'/static/img/queuefree/baoxiang.gif'}}" mode="aspectFill"></image></view></view><view data-event-opts="{{[['tap',[['randomScoreclose',['$event']]]]]}}" class="hongbao-view-close" style="bottom:-150rpx;" onTap="__e"><image src="{{pre_url+'/static/img/close2.png'}}"></image></view></view><uni-popup onChange="__e" vue-id="97f46c00-5" ref="__r" data-ref="popup" data-event-opts="{{[['^change',[['']]]]}}" onVueInit="__l"><view class="cl-popup"><view class="main"><image class="top" src="{{pre_url+'/static/img/popup-top.png'}}" mode="aspectFill"></image><image class="icon" src="{{pre_url+'/static/img/popup-icon.png'}}" mode="aspectFill"></image><image class="bottom" src="{{pre_url+'/static/img/popup-bottom.png'}}" mode="aspectFill"></image><view class="content"><view class="price"><text class="num">{{randomScore}}</text><text class="unit">{{$root.m10}}</text></view><view class="title">{{'奖励将发放到个人'+$root.m11+'账户'}}</view><view data-event-opts="{{[['tap',[['randomScoreclose',['$event']]]]]}}" class="cl-button" onTap="__e"><text>确定</text></view></view></view></view></uni-popup></view></block><block a:if="{{loading}}"><loading vue-id="97f46c00-6" onVueInit="__l"></loading></block><dp-tabbar vue-id="97f46c00-7" opt="{{opt}}" onVueInit="__l"></dp-tabbar><popmsg vue-id="97f46c00-8" ref="__r" data-ref="popmsg" onVueInit="__l"></popmsg></view>