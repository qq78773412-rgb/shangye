<view class="container"><block a:if="{{isload}}"><block><block a:if="{{show_rebate}}"><view class="container-top"><view class="top-content"><text class="t1">{{"待返"+$root.m0+"："+info.un_send_money+''}}</text><text class="t1">{{"已返"+$root.m1+"："+info.send_money+''}}</text></view><view class="top-content"><text class="t1">{{"待返"+$root.m2+"："+info.un_send_commission+''}}</text><text class="t1">{{"已返"+$root.m3+"："+info.send_commission+''}}</text></view><view class="top-content"><text class="t1">{{"待返"+$root.m4+"："+info.un_send_score+''}}</text><text class="t1">{{"已返"+$root.m5+"："+info.send_score+''}}</text></view></view></block><dd-tab class="{{(show_rebate?'container-tab':'')}}" vue-id="79d172ab-1" itemdata="{{['全部','进行中','已结束']}}" itemst="{{['all','1','2']}}" st="{{st}}" isfixed="{{true}}" data-event-opts="{{[['^changetab',[['changetab']]]]}}" onChangetab="__e" onVueInit="__l"></dd-tab><view style="{{(show_rebate?'height:260rpx;width:100%;':'height:100rpx;width:100%;')}}"></view><view class="order-content"><block a:for="{{datalist}}" a:for-item="item" a:for-index="index" a:key="index"><view class="order-box" data-url="{{'recordlog?cashback_id='+item.cashback_id+'&pro_id='+item.pro_id}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" catchTap="__e"><view class="head flex flex-y-center"><view class="head-top-view flex flex-y-center"><image src="{{pre_url+'/static/img/ico-shop.png'}}"></image><view class="head-title">{{"活动名称："+item.name}}</view></view><text class="st0">{{item.status}}</text></view><view class="content flex-col"><block a:if="{{item.cashback_money_max>0}}"><view class="flex-y-center option-content">{{"额度:"+item.cashback_money_max}}</view></block><block a:else><view class="flex-y-center option-content">额度：不限</view></block><view class="flex-y-center option-content">{{"已返"+item.back_type_name+"："+item.cashback_num}}</view><view class="flex-y-center option-content"><view class="progress-box"><progress percent="{{item.progress}}" show-info="{{true}}" stroke-width="5" activeColor="#ff8758" border-radius="50"></progress></view></view></view></view></block></view><block a:if="{{nomore}}"><nomore vue-id="79d172ab-2" onVueInit="__l"></nomore></block><block a:if="{{nodata}}"><nodata vue-id="79d172ab-3" onVueInit="__l"></nodata></block></block></block><block a:if="{{loading}}"><loading vue-id="79d172ab-4" onVueInit="__l"></loading></block><dp-tabbar vue-id="79d172ab-5" opt="{{opt}}" onVueInit="__l"></dp-tabbar><popmsg vue-id="79d172ab-6" ref="__r" data-ref="popmsg" onVueInit="__l"></popmsg></view>