<view><block a:if="{{isload}}"><block><view class="container"><view class="swiper-container"><swiper class="swiper" indicator-dots="{{false}}" autoplay="{{true}}" interval="{{5000}}" data-event-opts="{{[['change',[['swiperChange',['$event']]]]]}}" onChange="__e"><block a:for="{{product.pics}}" a:for-item="item" a:for-index="index" a:key="index"><swiper-item class="swiper-item"><view class="swiper-item-view"><image class="img" src="{{item}}" mode="widthFix"></image></view></swiper-item></block></swiper><view class="imageCount">{{current+1+"/"+product.pics.length}}</view></view><view class="collage_title flex-bt"><text><text class="price">{{"￥"+product.sell_price}}</text><text class="m-price">{{"￥"+product.market_price}}</text></text><view class="ps_title flex-y-center" style="{{'background:'+('rgba('+$root.m0+',0.12)')+';'+('color:'+($root.m1)+';')}}">{{product.ps_cycle_title}}</view></view><view class="header"><view class="title"><view class="lef"><text>{{product.name}}</text></view><view data-event-opts="{{[['tap',[['shareClick',['$event']]]]]}}" class="share" onTap="__e"><image src="{{pre_url+'/static/img/share.png'}}"></image><text>分享</text></view></view><view class="sales_stock"><view class="f2">{{"库存:"+product.stock}}</view></view></view><block a:if="{{shopset.comment==1&&commentcount>0}}"><view class="commentbox"><view class="title"><view class="f1">{{"评价("+commentcount+")"}}</view><view class="f2" data-url="{{'commentlist?proid='+product.id}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" onTap="__e">好评度<text style="{{'color:'+($root.m2)+';'}}">{{product.comment_haopercent+"%"}}</text><image style="width:32rpx;height:32rpx;" src="{{pre_url+'/static/img/arrowright.png'}}"></image></view></view><view class="comment"><block a:if="{{commentlist.length>0}}"><view class="item"><view class="f1"><image class="t1" src="{{commentlist[0].headimg}}"></image><view class="t2">{{commentlist[0].nickname}}</view><view class="flex1"></view><view class="t3"><image class="img" src="{{pre_url+'/static/img/star'+(commentlist[0].score>item2?'2native':'')+'.png'}}" a:for="{{[0,1,2,3,4]}}" a:for-item="item2" a:for-index="index2" a:key="index2"></image></view></view><view class="f2"><text class="t1">{{commentlist[0].content}}</text><view class="t2"><block a:if="{{commentlist[0].content_pic!=''}}"><block><block a:for="{{commentlist[0].content_pic}}" a:for-item="itemp" a:for-index="index" a:key="index"><view data-url="{{itemp}}" data-urls="{{commentlist[0].content_pic}}" data-event-opts="{{[['tap',[['previewImage',['$event']]]]]}}" onTap="__e"><image src="{{itemp}}" mode="widthFix"></image></view></block></block></block></view></view><view class="f3" data-url="{{'commentlist?proid='+product.id}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" onTap="__e">查看全部评价</view></view></block><block a:else><view class="nocomment">暂无评价~</view></block></view></view></block><block a:if="{{shopset.showjd==1}}"><view class="shop"><image class="p1" src="{{business.logo}}"></image><view class="p2 flex1"><view class="t1">{{business.name}}</view><view class="t2">{{business.desc}}</view></view><button class="p4" style="{{('background:linear-gradient(90deg,'+$root.m3+' 0%,rgba('+$root.m4+',0.8) 100%)')}}" data-url="{{product.bid==0?'/pages/index/index':'/pagesExt/business/index?id='+product.bid}}" data-opentype="reLaunch" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" onTap="__e">进入店铺</button></view></block><view class="detail_title"><view class="t1"></view><view class="t2"></view><view class="t0">商品描述</view><view class="t2"></view><view class="t1"></view></view><view class="detail"><dp vue-id="15f1f61a-1" pagecontent="{{pagecontent}}" onVueInit="__l"></dp></view><view style="width:100%;height:70px;"></view><block a:if="{{product.status==1}}"><view class="{{(((('bottombar')+' '+'flex-row')+' '+'flex-xy-center')+' '+(menuindex>-1?'tabbarbot':'notabbarbot'))}}"><block a:if="{{kfurl!='contact::'}}"><view class="cart flex-col flex-x-center flex-y-center" data-url="{{kfurl}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" onTap="__e"><image class="img" src="{{pre_url+'/static/img/kefu.png'}}"></image><view class="t1">客服</view></view></block><block a:else><button class="cart flex-col flex-x-center flex-y-center" open-type="contact" show-message-card="true"><image class="img" src="{{pre_url+'/static/img/kefu.png'}}"></image><view class="t1">客服</view></button></block><view data-event-opts="{{[['tap',[['shareClick',['$event']]]]]}}" class="cart flex-col flex-x-center flex-y-center" onTap="__e"><image class="img" src="{{pre_url+'/static/img/share2.png'}}"></image><view class="t1">分享</view></view><view data-event-opts="{{[['tap',[['addfavorite',['$event']]]]]}}" class="favorite flex-col flex-x-center flex-y-center" onTap="__e"><image class="img" src="{{pre_url+'/static/img/shoucang.png'}}"></image><view class="t1">{{isfavorite?'已收藏':'收藏'}}</view></view><view class="tobuy flex1" style="{{'background:'+($root.m5)+';'}}" data-url="{{'/pagesExt/cycle/planWrite?id='+product.id}}" data-event-opts="{{[['tap',[['toPlanList',['$event']]]]]}}" onTap="__e"><text>购买</text></view></view></block><view hidden="{{buydialogHidden}}"><view class="buydialog-mask"><view class="{{(('buydialog')+' '+(menuindex>-1?'tabbarbot':'notabbarbot'))}}"><view data-event-opts="{{[['tap',[['buydialogChange',['$event']]]]]}}" class="close" onTap="__e"><image class="image" src="{{pre_url+'/static/img/close.png'}}"></image></view><view class="title"><image class="img" src="{{guigelist[ks].pic?guigelist[ks].pic:product.pic}}" data-url="{{guigelist[ks].pic?guigelist[ks].pic:product.pic}}" data-event-opts="{{[['tap',[['previewImage',['$event']]]]]}}" onTap="__e"></image><block a:if="{{btntype==1}}"><view class="price"><text class="t1">￥</text>{{guigelist[ks].market_price}}</view></block><block a:else><view class="price"><text class="t1">￥</text>{{guigelist[ks].sell_price+''}}<block a:if="{{guigelist[ks].market_price>guigelist[ks].sell_price}}"><text class="t2">{{"￥"+guigelist[ks].market_price}}</text></block></view></block><view class="choosename">{{"已选规格: "+guigelist[ks].name}}</view><view class="stock">{{"剩余"+guigelist[ks].stock+"件"}}</view></view><view class="guigelist flex-col" a:for="{{guigedata}}" a:for-item="item" a:for-index="index" a:key="index"><view class="name">{{item.title}}</view><view class="item flex flex-y-center"><block a:for="{{item.items}}" a:for-item="item2" a:for-index="index2" a:key="index2"><view class="{{('item2 '+(ggselected[item.k]==item2.k?'on':''))}}" data-itemk="{{item.k}}" data-idx="{{item2.k}}" data-event-opts="{{[['tap',[['ggchange',['$event']]]]]}}" onTap="__e">{{item2.title}}</view></block></view></view><view class="buynum flex flex-y-center"><view class="flex1">购买数量：</view><view class="addnum"><view class="minus"><image class="img" src="{{pre_url+'/static/img/cart-minus.png'}}" data-event-opts="{{[['tap',[['gwcminus',['$event']]]]]}}" onTap="__e"></image></view><input class="input" type="number" data-event-opts="{{[['input',[['gwcinput',['$event']]]]]}}" value="{{gwcnum}}" onInput="__e"/><view class="plus"><image class="img" src="{{pre_url+'/static/img/cart-plus.png'}}" data-event-opts="{{[['tap',[['gwcplus',['$event']]]]]}}" onTap="__e"></image></view></view></view><view class="op"><block a:if="{{btntype==1}}"><block><button class="tobuy" style="{{'background:'+($root.m6)+';'}}" data-type="1" data-event-opts="{{[['tap',[['tobuy',['$event']]]]]}}" onTap="__e">确定</button></block></block><block a:if="{{btntype==2}}"><block><button class="tobuy" style="{{'background:'+($root.m7)+';'}}" data-type="2" data-event-opts="{{[['tap',[['tobuy',['$event']]]]]}}" onTap="__e">下一步</button></block></block><block a:if="{{btntype==3}}"><block><button class="tobuy" style="{{'background:'+($root.m8)+';'}}" data-type="3" data-event-opts="{{[['tap',[['tobuy',['$event']]]]]}}" onTap="__e">确 定</button></block></block></view></view></view></view></view><block a:if="{{sharetypevisible}}"><view class="popup__container"><view data-event-opts="{{[['tap',[['handleClickMask',['$event']]]]]}}" class="popup__overlay" catchTap="__e"></view><view class="popup__modal" style="height:320rpx;min-height:320rpx;"><view class="popup__content"><view class="sharetypecontent"><block a:if="{{$root.m9=='app'}}"><view data-event-opts="{{[['tap',[['shareapp',['$event']]]]]}}" class="f1" onTap="__e"><image class="img" src="{{pre_url+'/static/img/sharefriends.png'}}"></image><text class="t1">分享给好友</text></view></block><block a:else><block a:if="{{$root.m10=='mp'}}"><view data-event-opts="{{[['tap',[['sharemp',['$event']]]]]}}" class="f1" onTap="__e"><image class="img" src="{{pre_url+'/static/img/sharefriends.png'}}"></image><text class="t1">分享给好友</text></view></block><block a:else><block a:if="{{$root.m11!='h5'}}"><button class="f1" open-type="share"><image class="img" src="{{pre_url+'/static/img/sharefriends.png'}}"></image><text class="t1">分享给好友</text></button></block></block></block><view data-event-opts="{{[['tap',[['showPoster',['$event']]]]]}}" class="f2" onTap="__e"><image class="img" src="{{pre_url+'/static/img/sharepic.png'}}"></image><text class="t1">生成分享图片</text></view></view></view></view></view></block><block a:if="{{showposter}}"><view class="posterDialog"><view class="main"><view data-event-opts="{{[['tap',[['posterDialogClose',['$event']]]]]}}" class="close" onTap="__e"><image class="img" src="{{pre_url+'/static/img/close.png'}}"></image></view><view class="content"><image class="img" src="{{posterpic}}" mode="widthFix" data-url="{{posterpic}}" data-event-opts="{{[['tap',[['previewImage',['$event']]]]]}}" onTap="__e"></image></view></view></view></block></block></block><block a:if="{{loading}}"><loading vue-id="15f1f61a-2" onVueInit="__l"></loading></block><dp-tabbar vue-id="15f1f61a-3" opt="{{opt}}" data-event-opts="{{[['^getmenuindex',[['getmenuindex']]]]}}" onGetmenuindex="__e" onVueInit="__l"></dp-tabbar><popmsg vue-id="15f1f61a-4" ref="__r" data-ref="popmsg" onVueInit="__l"></popmsg></view>