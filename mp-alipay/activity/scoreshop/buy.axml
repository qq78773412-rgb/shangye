<view class="container"><block a:if="{{isload}}"><block><form data-event-opts="{{[['submit',[['topay',['$event']]]]]}}" onSubmit="__e"><block a:if="{{needaddress==0}}"><view class="address-add"><view class="linkitem"><block a:if="{{contact_require==1}}"><label style="color:red;">*</label></block><text class="f1">联 系 人：</text><input class="input" type="text" placeholder="请输入您的姓名" placeholder-style="color:#626262;font-size:28rpx" data-event-opts="{{[['input',[['inputLinkman',['$event']]]]]}}" value="{{linkman}}" onInput="__e"/></view><view class="linkitem"><block a:if="{{contact_require==1}}"><label style="color:red;">*</label></block><text class="f1">联系电话：</text><input class="input" type="text" placeholder="请输入您的手机号" placeholder-style="color:#626262;font-size:28rpx" data-event-opts="{{[['input',[['inputTel',['$event']]]]]}}" value="{{tel}}" onInput="__e"/></view></view></block><block a:else><view class="address-add flex-y-center" data-url="{{'/pagesB/address/address?fromPage=buy&type='+(havetongcheng==1?'1':'0')}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" onTap="__e"><view class="f1"><image class="img" src="{{pre_url+'/static/img/address.png'}}"></image></view><block a:if="{{address.name}}"><view class="f2 flex1"><view style="font-weight:bold;color:#111111;font-size:30rpx;">{{address.name+" "+address.tel+''}}<block a:if="{{address.company}}"><text>{{address.company}}</text></block></view><view style="font-size:24rpx;">{{address.area+" "+address.address}}</view></view></block><block a:else><view class="f2 flex1">请选择收货地址</view></block><image class="f3" src="{{pre_url+'/static/img/arrowright.png'}}"></image></view></block><view class="buydata" a:for="{{$root.l4}}" a:for-item="buydata" a:for-index="index" a:key="index"><view class="btitle"><image class="img" src="{{pre_url+'/static/img/ico-shop.png'}}"></image>{{buydata.$orig.business.name+''}}</view><view class="bcontent"><view class="product"><view class="item flex" a:for="{{buydata.$orig.prodata}}" a:for-item="item" a:for-index="index2" a:key="index2"><view class="img"><image class="img" src="{{item.product.ggpic||item.product.pic}}"></image></view><view class="info flex1"><view class="f1">{{item.product.name}}</view><block a:if="{{item.product.ggname}}"><view class="f2" style="color:#666;">{{"已选规格: "+item.product.ggname}}</view></block><block a:else><view class="f2">{{"市场价: ￥"+item.product.sell_price}}</view></block><view class="f3" style="{{'color:'+(buydata.m0)+';'}}">{{item.product.score_price+buydata.m1}}<block a:if="{{item.product.money_price>0}}"><text>{{"+"+item.product.money_price+"元"}}</text></block><text style="padding-left:10rpx;">{{'× '+item.num}}</text></view></view></view></view><view class="freight"><view class="f1">配送方式</view><view class="freight-ul"><view class="flex" style="width:100%;overflow-y:hidden;overflow-x:scroll;"><block a:for="{{buydata.l0}}" a:for-item="item" a:for-index="idx2" a:key="idx2"><view class="freight-li" style="{{(buydata.$orig.freightkey==idx2?'color:'+item.m2+';background:rgba('+item.m3+',0.2)':'')}}" data-bid="{{buydata.$orig.bid}}" data-index="{{idx2}}" data-event-opts="{{[['tap',[['changeFreight',['$event']]]]]}}" onTap="__e">{{item.$orig.name+''}}</view></block></view></view><block a:if="{{buydata.$orig.freightList[buydata.$orig.freightkey].minpriceset==1&&buydata.$orig.freightList[buydata.$orig.freightkey].minprice>0&&buydata.$orig.freightList[buydata.$orig.freightkey].minprice*1>buydata.$orig.product_price*1}}"><view class="freighttips">{{'满'+buydata.$orig.freightList[buydata.$orig.freightkey].minprice+"元起送，还差"+buydata.g0+'元'}}</view></block><block a:if="{{buydata.$orig.freightList[buydata.$orig.freightkey].isoutjuli==1}}"><view class="freighttips">超出配送范围</view></block></view><block a:if="{{buydata.$orig.freightList[buydata.$orig.freightkey].pstimeset==1}}"><view class="price"><view class="f1">{{(buydata.$orig.freightList[buydata.$orig.freightkey].pstype==1?'取货':'配送')+"时间"}}</view><view class="f2" data-bid="{{buydata.$orig.bid}}" data-event-opts="{{[['tap',[['choosePstime',['$event']]]]]}}" onTap="__e">{{''+(buydata.$orig.pstimetext==''?'请选择时间':buydata.$orig.pstimetext)}}<text class="iconfont iconjiantou" style="color:#999;font-weight:normal;"></text></view></view></block><block a:if="{{buydata.$orig.freightList[buydata.$orig.freightkey].pstype==1&&buydata.$orig.freightList[buydata.$orig.freightkey].isbusiness!=1}}"><view class="storeitem"><view class="panel"><view class="f1">取货地点</view><view class="f2" data-bid="{{buydata.$orig.bid}}" data-freightkey="{{buydata.$orig.freightkey}}" data-storekey="{{buydata.$orig.freightList[buydata.$orig.freightkey].storekey}}" data-event-opts="{{[['tap',[['openMendian',['$event']]]]]}}" onTap="__e"><text class="iconfont icondingwei"></text>{{buydata.$orig.freightList[buydata.$orig.freightkey].storedata[buydata.$orig.freightList[buydata.$orig.freightkey].storekey].name+''}}</view></view><block a:for="{{buydata.l1}}" a:for-item="item" a:for-index="idx" a:key="idx"><block a:if="{{idx<5||storeshowall==true}}"><view class="radio-item" data-bid="{{buydata.$orig.bid}}" data-index="{{idx}}" data-event-opts="{{[['tap',[['choosestore',['$event']]]]]}}" catchTap="__e"><view class="f1"><view>{{item.$orig.name}}</view><block a:if="{{item.$orig.address}}"><view class="flex-y-center" style="text-align:left;font-size:24rpx;color:#aaaaae;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:1;overflow:hidden;">{{item.$orig.address}}</view></block></view><text style="color:#f50;">{{item.$orig.juli}}</text><view class="radio" style="{{(buydata.$orig.freightList[buydata.$orig.freightkey].storekey==idx?'background:'+item.m4+';border:0':'')}}"><image class="radio-img" src="{{pre_url+'/static/img/checkd.png'}}"></image></view></view></block></block><block a:if="{{storeshowall==false&&buydata.$orig.freightList[buydata.$orig.freightkey].storedata.length>5}}"><view data-event-opts="{{[['tap',[['doStoreShowAll',['$event']]]]]}}" class="storeviewmore" onTap="__e">- 查看更多 -</view></block></view></block><block a:if="{{buydata.$orig.freightList[buydata.$orig.freightkey].pstype==1&&buydata.$orig.freightList[buydata.$orig.freightkey].isbusiness==1}}"><view class="storeitem"><view class="panel"><view class="f1">取货地点</view></view><block a:for="{{buydata.$orig.freightList[buydata.$orig.freightkey].storedata}}" a:for-item="item" a:for-index="idx" a:key="idx"><block a:if="{{idx<5||storeshowall==true}}"><view class="radio-item" data-freightkey="{{buydata.$orig.freightkey}}" data-storekey="{{idx}}" data-bid="{{buydata.$orig.bid}}" data-index="{{idx}}" data-event-opts="{{[['tap',[['openLocation',['$event']]]]]}}" onTap="__e"><view class="f1"><view>{{item.name}}</view><block a:if="{{item.address}}"><view class="flex-y-center" style="text-align:left;font-size:24rpx;color:#aaaaae;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:1;overflow:hidden;">{{item.address}}</view></block></view><text style="color:#f50;">{{item.juli}}</text></view></block></block><block a:if="{{storeshowall==false&&buydata.$orig.freightList[buydata.$orig.freightkey].storedata.length>5}}"><view data-event-opts="{{[['tap',[['doStoreShowAll',['$event']]]]]}}" class="storeviewmore" onTap="__e">- 查看更多 -</view></block></view></block><block a:if="{{buydata.$orig.freightList[buydata.$orig.freightkey].pstype==5}}"><view class="storeitem"><view class="panel"><view class="f1">配送门店</view><view class="f2" data-bid="{{buydata.$orig.bid}}" data-freightkey="{{buydata.$orig.freightkey}}" data-storekey="{{buydata.$orig.freightList[buydata.$orig.freightkey].storekey}}" data-event-opts="{{[['tap',[['openMendian',['$event']]]]]}}" onTap="__e"><text class="iconfont icondingwei"></text>{{buydata.$orig.freightList[buydata.$orig.freightkey].storedata[buydata.$orig.freightList[buydata.$orig.freightkey].storekey].name+''}}</view></view><block a:for="{{buydata.l2}}" a:for-item="item" a:for-index="idx" a:key="idx"><block a:if="{{idx<5||storeshowall==true}}"><view class="radio-item" data-bid="{{buydata.$orig.bid}}" data-index="{{idx}}" data-event-opts="{{[['tap',[['choosestore',['$event']]]]]}}" catchTap="__e"><view class="f1"><view>{{item.$orig.name}}</view><block a:if="{{item.$orig.address}}"><view style="text-align:left;font-size:24rpx;color:#aaaaae;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:1;overflow:hidden;">{{item.$orig.address}}</view></block></view><text style="color:#f50;">{{item.$orig.juli}}</text><view class="radio" style="{{(buydata.$orig.freightList[buydata.$orig.freightkey].storekey==idx?'background:'+item.m5+';border:0':'')}}"><image class="radio-img" src="{{pre_url+'/static/img/checkd.png'}}"></image></view></view></block></block><block a:if="{{storeshowall==false&&buydata.$orig.freightList[buydata.$orig.freightkey].storedata.length>5}}"><view data-event-opts="{{[['tap',[['doStoreShowAll',['$event']]]]]}}" class="storeviewmore" onTap="__e">- 查看更多 -</view></block></view></block><view class="price"><text class="f1">商品金额</text><text class="f2">{{"¥"+buydata.$orig.product_price}}</text></view><view class="price"><text class="f1">{{"所需"+$root.m6}}</text><text class="f2">{{buydata.$orig.product_score}}</text></view><view class="price"><view class="f1">{{buydata.$orig.freightList[buydata.$orig.freightkey].freight_price_txt||'运费'}}<block a:if="{{buydata.$orig.freightList[buydata.$orig.freightkey].pstype!=1&&buydata.$orig.freightList[buydata.$orig.freightkey].freeset==1}}"><text style="color:#aaa;font-size:24rpx;">{{"（满"+buydata.$orig.freightList[buydata.$orig.freightkey].free_price+"元包邮）"}}</text></block></view><text class="f2">{{"+¥"+buydata.$orig.freightList[buydata.$orig.freightkey].freight_price}}</text></view><view style="display:none;">{{test}}</view><view class="form-item" a:for="{{buydata.l3}}" a:for-item="item" a:for-index="idx" a:key="id"><view class="label">{{item.$orig.val1}}<block a:if="{{item.$orig.val3==1}}"><text style="color:red;">*</text></block></view><block a:if="{{item.$orig.key=='input'}}"><block><input class="input" type="text" name="{{'form'+buydata.$orig.bid+'_'+idx}}" placeholder="{{item.$orig.val2}}" placeholder-style="font-size:28rpx"/></block></block><block a:if="{{item.$orig.key=='textarea'}}"><block><textarea class="textarea" name="{{'form'+buydata.$orig.bid+'_'+idx}}" placeholder="{{item.$orig.val2}}" placeholder-style="font-size:28rpx"></textarea></block></block><block a:if="{{item.$orig.key=='radio'}}"><block><radio-group class="radio-group" name="{{'form'+buydata.$orig.bid+'_'+idx}}"><label class="flex-y-center" a:for="{{item.$orig.val2}}" a:for-item="item1" a:for-index="idx1" a:key="id"><radio class="radio" value="{{item1}}"></radio>{{item1+''}}</label></radio-group></block></block><block a:if="{{item.$orig.key=='checkbox'}}"><block><checkbox-group class="checkbox-group" name="{{'form'+buydata.$orig.bid+'_'+idx}}"><label class="flex-y-center" a:for="{{item.$orig.val2}}" a:for-item="item1" a:for-index="idx1" a:key="id"><checkbox class="checkbox" value="{{item1}}"></checkbox>{{item1+''}}</label></checkbox-group></block></block><block a:if="{{item.$orig.key=='selector'}}"><block><picker class="picker" mode="selector" name="{{'form'+buydata.$orig.bid+'_'+idx}}" value="{{item.$orig.val2[buydata.$orig.editorFormdata[idx]]}}" range="{{item.$orig.val2}}" data-bid="{{buydata.$orig.bid}}" data-idx="{{idx}}" data-event-opts="{{[['change',[['editorBindPickerChange',['$event']]]]]}}" onChange="__e"><block a:if="{{buydata.$orig.editorFormdata&&(buydata.$orig.editorFormdata[idx]||buydata.$orig.editorFormdata[idx]===0)}}"><view>{{''+item.$orig.val2[buydata.$orig.editorFormdata[idx]]}}</view></block><block a:else><view>请选择</view></block></picker><text class="iconfont iconjiantou" style="color:#999;font-weight:normal;"></text></block></block><block a:if="{{item.$orig.key=='time'}}"><block><picker class="picker" mode="time" name="{{'form'+buydata.$orig.bid+'_'+idx}}" value="{{buydata.$orig.editorFormdata[idx]}}" start="{{item.$orig.val2[0]}}" end="{{item.$orig.val2[1]}}" range="{{item.$orig.val2}}" data-bid="{{buydata.$orig.bid}}" data-idx="{{idx}}" data-event-opts="{{[['change',[['editorBindPickerChange',['$event']]]]]}}" onChange="__e"><block a:if="{{buydata.$orig.editorFormdata&&buydata.$orig.editorFormdata[idx]}}"><view>{{buydata.$orig.editorFormdata[idx]}}</view></block><block a:else><view>请选择</view></block></picker><text class="iconfont iconjiantou" style="color:#999;font-weight:normal;"></text></block></block><block a:if="{{item.$orig.key=='date'}}"><block><picker class="picker" mode="date" name="{{'form'+buydata.$orig.bid+'_'+idx}}" value="{{buydata.$orig.editorFormdata[idx]}}" start="{{item.$orig.val2[0]}}" end="{{item.$orig.val2[1]}}" range="{{item.$orig.val2}}" data-bid="{{buydata.$orig.bid}}" data-idx="{{idx}}" data-event-opts="{{[['change',[['editorBindPickerChange',['$event']]]]]}}" onChange="__e"><block a:if="{{buydata.$orig.editorFormdata&&buydata.$orig.editorFormdata[idx]}}"><view>{{buydata.$orig.editorFormdata[idx]}}</view></block><block a:else><view>请选择</view></block></picker><text class="iconfont iconjiantou" style="color:#999;font-weight:normal;"></text></block></block><block a:if="{{item.$orig.key=='upload'&&buydata.$orig.editorFormdata}}"><block><input style="display:none;" type="text" name="{{'form'+buydata.$orig.bid+'_'+idx}}" value="{{buydata.$orig.editorFormdata[idx]}}"/><view class="flex" style="flex-wrap:wrap;padding-top:20rpx;"><block a:if="{{buydata.$orig.editorFormdata[idx]}}"><view class="form-imgbox"><view class="layui-imgbox-close" style="z-index:2;" data-bid="{{buydata.$orig.bid}}" data-idx="{{idx}}" data-event-opts="{{[['tap',[['removeimg',['$event']]]]]}}" onTap="__e"><image style="display:block;" src="{{pre_url+'/static/img/ico-del.png'}}"></image></view><view class="form-imgbox-img"><image class="image" src="{{buydata.$orig.editorFormdata[idx]}}" data-url="{{buydata.$orig.editorFormdata[idx]}}" mode="aspectFit" data-event-opts="{{[['tap',[['previewImage',['$event']]]]]}}" onTap="__e"></image></view></view></block><block a:else><view class="form-uploadbtn" style="{{'background:'+('url('+pre_url+'/static/img/shaitu_icon.png) no-repeat 50rpx')+';'+('background-size:'+('80rpx 80rpx')+';')+('background-color:'+('#F3F3F3')+';')}}" data-bid="{{buydata.$orig.bid}}" data-idx="{{idx}}" data-event-opts="{{[['tap',[['editorChooseImage',['$event']]]]]}}" onTap="__e"></view></block></view></block></block><block a:if="{{item.$orig.key=='upload_pics'}}"><block><input style="display:none;" type="text" name="{{'form'+buydata.$orig.bid+'_'+idx}}" maxlength="-1" value="{{buydata.$orig.editorFormdata&&buydata.$orig.editorFormdata[idx]?item.g1:''}}"/><view class="flex" style="flex-wrap:wrap;padding-top:20rpx;"><view class="form-imgbox" a:for="{{buydata.$orig.editorFormdata[idx]}}" a:for-item="item2" a:for-index="index2" a:key="index2"><view class="layui-imgbox-close" data-bid="{{buydata.$orig.bid}}" data-index="{{index2}}" data-type="pics" data-idx="{{idx}}" data-formidx="{{'form'+idx}}" data-event-opts="{{[['tap',[['removeimg',['$event']]]]]}}" onTap="__e"><image class="image" src="{{pre_url+'/static/img/ico-del.png'}}"></image></view><view class="form-imgbox-img" style="margin-bottom:10rpx;"><image class="image" src="{{item2}}" data-url="{{item2}}" mode="aspectFit" data-idx="{{idx}}" data-event-opts="{{[['tap',[['previewImage',['$event']]]]]}}" onTap="__e"></image></view></view><view class="form-uploadbtn" style="{{'background:'+('url('+pre_url+'/static/img/shaitu_icon.png) no-repeat 50rpx')+';'+('background-size:'+('80rpx 80rpx')+';')+('background-color:'+('#F3F3F3')+';')}}" data-bid="{{buydata.$orig.bid}}" data-idx="{{idx}}" data-formidx="{{'form'+idx}}" data-type="pics" data-event-opts="{{[['tap',[['editorChooseImages',['$event']]]]]}}" onTap="__e"></view></view></block></block></view></view></view><view style="width:100%;height:110rpx;"></view><view class="footer flex notabbarbot"><view class="f1 flex1">总计：<block a:if="{{totalprice*1>0}}"><text class="txt" style="{{'font-weight:bold;'+('color:'+($root.m7)+';')}}">{{"￥"+totalprice+" + "+totalscore+$root.m8}}</text></block><block a:else><text class="txt" style="{{'color:'+($root.m9)+';'}}">{{totalscore+$root.m10}}</text></block></view><button class="op" style="{{'background:'+('linear-gradient(-90deg,'+$root.m11+' 0%,rgba('+$root.m12+',0.8) 100%)')+';'}}" form-type="submit">提交订单</button></view></form><block a:if="{{pstimeDialogShow}}"><view class="popup__container"><view data-event-opts="{{[['tap',[['hidePstimeDialog',['$event']]]]]}}" class="popup__overlay" catchTap="__e"></view><view class="popup__modal"><view class="popup__title"><text class="popup__title-text">{{"请选择"+(allbuydata[nowbid].freightList[allbuydata[nowbid].freightkey].pstype==1?'取货':'配送')+"时间"}}</text><image class="popup__close" style="width:36rpx;height:36rpx;" src="{{pre_url+'/static/img/close.png'}}" data-event-opts="{{[['tap',[['hidePstimeDialog',['$event']]]]]}}" catchTap="__e"></image></view><view class="popup__content"><view class="pstime-item" data-index="{{index}}" data-event-opts="{{[['tap',[['pstimeRadioChange',['$event']]]]]}}" onTap="__e" a:for="{{$root.l5}}" a:for-item="item" a:for-index="index" a:key="index"><view class="flex1">{{item.$orig.title}}</view><view class="radio" style="{{(allbuydata[nowbid].freight_time==item.$orig.value?'background:'+item.m13+';border:0':'')}}"><image class="radio-img" src="{{pre_url+'/static/img/checkd.png'}}"></image></view></view></view></view></view></block></block></block><block a:if="{{loading}}"><loading vue-id="35ba196f-1" onVueInit="__l"></loading></block><dp-tabbar vue-id="35ba196f-2" opt="{{opt}}" onVueInit="__l"></dp-tabbar><popmsg vue-id="35ba196f-3" ref="__r" data-ref="popmsg" onVueInit="__l"></popmsg><wxxieyi vue-id="35ba196f-4" onVueInit="__l"></wxxieyi></view>