<view class="container"><block a:if="{{isload}}"><block><form data-event-opts="{{[['submit',[['topay',['$event']]]]]}}" onSubmit="__e"><block a:if="{{needaddress==0}}"><view class="address-add"><view class="linkitem"><block a:if="{{contact_require==1}}"><label style="color:red;">*</label></block><text class="f1">联 系 人：</text><input class="input" type="text" placeholder="请输入您的姓名" placeholder-style="color:#626262;font-size:28rpx;" data-event-opts="{{[['input',[['inputLinkman',['$event']]]]]}}" value="{{linkman}}" onInput="__e"/></view><view class="linkitem"><block a:if="{{contact_require==1}}"><label style="color:red;">*</label></block><text class="f1">联系电话：</text><input class="input" type="text" placeholder="请输入您的手机号" placeholder-style="color:#626262;font-size:28rpx;" data-event-opts="{{[['input',[['inputTel',['$event']]]]]}}" value="{{tel}}" onInput="__e"/></view></view></block><block a:else><view class="address-add flex-y-center" data-url="{{'/pagesB/address/address?fromPage=buy&type='+(havetongcheng==1?'1':'0')}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" onTap="__e"><view class="f1"><image class="img" src="{{pre_url+'/static/img/address.png'}}"></image></view><block a:if="{{address.name}}"><view class="f2 flex1"><view style="font-weight:bold;color:#111111;font-size:30rpx;">{{address.name+" "+address.tel+''}}<block a:if="{{address.company}}"><text>{{address.company}}</text></block></view><view style="font-size:24rpx;">{{address.area+" "+address.address}}</view></view></block><block a:else><view class="f2 flex1">请选择收货地址</view></block><image class="f3" src="{{pre_url+'/static/img/arrowright.png'}}"></image></view></block><view class="buydata"><view class="btitle"><image class="img" src="{{pre_url+'/static/img/ico-shop.png'}}"></image>{{business.name}}</view><view class="bcontent"><view class="product"><view class="item flex"><view class="img"><block a:if="{{guige.pic}}"><image class="img" src="{{guige.pic}}"></image></block><block a:else><image class="img" src="{{product.pic}}"></image></block></view><view class="info flex1"><view class="f1">{{product.name}}</view><view class="f2">{{"规格："+guige.name}}</view><view class="f3">{{"￥"+guige.sell_price}}<block a:if="{{buytype!=1}}"><text class="collage_icon">拼团价</text></block>{{'× '+totalnum}}</view></view></view></view><view class="freight"><view class="f1">配送方式</view><view class="freight-ul"><view class="flex" style="width:100%;overflow-y:hidden;overflow-x:scroll;"><block a:for="{{$root.l0}}" a:for-item="item" a:for-index="idx2" a:key="idx2"><view class="freight-li" style="{{(freightkey==idx2?'color:'+item.m0+';background:rgba('+item.m1+',0.2)':'')}}" data-index="{{idx2}}" data-event-opts="{{[['tap',[['changeFreight',['$event']]]]]}}" onTap="__e">{{item.$orig.name}}</view></block></view></view><block a:if="{{freightList[freightkey].minpriceset==1&&freightList[freightkey].minprice>0&&freightList[freightkey].minprice>product_price}}"><view class="freighttips">{{"满"+freightList[freightkey].minprice+"元起送，还差"+$root.g0+"元"}}</view></block><block a:if="{{freightList[freightkey].isoutjuli==1}}"><view class="freighttips">超出配送范围</view></block></view><block a:if="{{freightList[freightkey].pstimeset==1}}"><view class="price"><view class="f1">{{(freightList[freightkey].pstype==1?'取货':'配送')+"时间"}}</view><view data-event-opts="{{[['tap',[['choosePstime',['$event']]]]]}}" class="f2" onTap="__e">{{pstimetext==''?'请选择时间':pstimetext}}<text class="iconfont iconjiantou" style="color:#999;font-weight:normal;"></text></view></view></block><block a:if="{{freightList[freightkey].pstype==1}}"><view class="storeitem"><view class="panel"><view class="f1">取货地点</view><view class="f2" data-freightkey="{{freightkey}}" data-storekey="{{freightList[freightkey].storekey}}" data-event-opts="{{[['tap',[['openMendian',['$event']]]]]}}" onTap="__e"><text class="iconfont icondingwei"></text>{{freightList[freightkey].storedata[freightList[freightkey].storekey].name}}</view></view><block a:for="{{$root.l1}}" a:for-item="item" a:for-index="idx" a:key="idx"><block a:if="{{idx<5||storeshowall==true}}"><view class="radio-item" data-index="{{idx}}" data-event-opts="{{[['tap',[['choosestore',['$event']]]]]}}" catchTap="__e"><view class="f1"><view>{{item.$orig.name}}</view><block a:if="{{item.$orig.address}}"><view class="flex-y-center" style="text-align:left;font-size:24rpx;color:#aaaaae;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:1;overflow:hidden;">{{item.$orig.address}}</view></block></view><text style="color:#f50;">{{item.$orig.juli}}</text><view class="radio" style="{{(freightList[freightkey].storekey==idx?'background:'+item.m2+';border:0':'')}}"><image class="radio-img" src="{{pre_url+'/static/img/checkd.png'}}"></image></view></view></block></block><block a:if="{{storeshowall==false&&freightList[freightkey].storedata.length>5}}"><view data-event-opts="{{[['tap',[['doStoreShowAll',['$event']]]]]}}" class="storeviewmore" onTap="__e">- 查看更多 -</view></block></view></block><view class="price"><text class="f1">商品金额</text><text class="f2">{{"¥"+product_price}}</text></view><block a:if="{{leadermoney*1>0}}"><view class="price"><text class="f1">团长优惠</text><text class="f2">{{"-¥"+leadermoney}}</text></view></block><block a:if="{{leveldk_money*1>0}}"><view class="price"><text class="f1">{{$root.m3+"折扣("+userinfo.discount+"折)"}}</text><text class="f2">{{"-¥"+leveldk_money}}</text></view></block><view class="price"><view class="f1"><block a:if="{{freightList[freightkey].pstype==1}}"><text>服务费</text></block><block a:else><text>运费</text></block></view><text class="f2">{{"+¥"+freight_price}}</text></view><view class="price"><view class="f1">{{$root.m4}}</view><block a:if="{{couponList.length>0}}"><view data-event-opts="{{[['tap',[['showCouponList',['$event']]]]]}}" class="f2" onTap="__e"><text style="{{'color:#fff;padding:4rpx 16rpx;font-weight:normal;border-radius:8rpx;font-size:24rpx;'+('background:'+($root.m5)+';')}}">{{couponrid!=0?couponList[couponkey].couponname:couponList.length+'张可用'}}</text><text class="iconfont iconjiantou" style="color:#999;font-weight:normal;"></text></view></block><block a:else><text class="f2" style="color:#999;">{{"无可用"+$root.m6}}</text></block></view><view style="display:none;">{{test}}</view><view class="form-item" a:for="{{$root.l2}}" a:for-item="item" a:for-index="idx" a:key="id"><view class="label">{{item.$orig.val1}}<block a:if="{{item.$orig.val3==1}}"><text style="color:red;">*</text></block></view><block a:if="{{item.$orig.key=='input'}}"><block><input class="input" type="text" name="{{'form'+idx}}" placeholder="{{item.$orig.val2}}" placeholder-style="font-size:28rpx"/></block></block><block a:if="{{item.$orig.key=='textarea'}}"><block><textarea class="textarea" name="{{'form'+idx}}" placeholder="{{item.$orig.val2}}" placeholder-style="font-size:28rpx"></textarea></block></block><block a:if="{{item.$orig.key=='radio'}}"><block><radio-group class="radio-group" name="{{'form'+idx}}"><label class="flex-y-center" a:for="{{item.$orig.val2}}" a:for-item="item1" a:for-index="idx1" a:key="id"><radio class="radio" value="{{item1}}"></radio>{{item1+''}}</label></radio-group></block></block><block a:if="{{item.$orig.key=='checkbox'}}"><block><checkbox-group class="checkbox-group" name="{{'form'+idx}}"><label class="flex-y-center" a:for="{{item.$orig.val2}}" a:for-item="item1" a:for-index="idx1" a:key="id"><checkbox class="checkbox" value="{{item1}}"></checkbox>{{item1+''}}</label></checkbox-group></block></block><block a:if="{{item.$orig.key=='selector'}}"><block><picker class="picker" mode="selector" name="{{'form'+idx}}" value="{{item.$orig.val2[editorFormdata[idx]]}}" range="{{item.$orig.val2}}" data-idx="{{idx}}" data-event-opts="{{[['change',[['editorBindPickerChange',['$event']]]]]}}" onChange="__e"><block a:if="{{editorFormdata[idx]||editorFormdata[idx]===0}}"><view>{{''+item.$orig.val2[editorFormdata[idx]]}}</view></block><block a:else><view>请选择</view></block></picker><text class="iconfont iconjiantou" style="color:#999;font-weight:normal;"></text></block></block><block a:if="{{item.$orig.key=='time'}}"><block><picker class="picker" mode="time" name="{{'form'+idx}}" value="{{editorFormdata[idx]}}" start="{{item.$orig.val2[0]}}" end="{{item.$orig.val2[1]}}" range="{{item.$orig.val2}}" data-idx="{{idx}}" data-event-opts="{{[['change',[['editorBindPickerChange',['$event']]]]]}}" onChange="__e"><block a:if="{{editorFormdata[idx]}}"><view>{{editorFormdata[idx]}}</view></block><block a:else><view>请选择</view></block></picker><text class="iconfont iconjiantou" style="color:#999;font-weight:normal;"></text></block></block><block a:if="{{item.$orig.key=='date'}}"><block><picker class="picker" mode="date" name="{{'form'+idx}}" value="{{editorFormdata[idx]}}" start="{{item.$orig.val2[0]}}" end="{{item.$orig.val2[1]}}" range="{{item.$orig.val2}}" data-idx="{{idx}}" data-event-opts="{{[['change',[['editorBindPickerChange',['$event']]]]]}}" onChange="__e"><block a:if="{{editorFormdata[idx]}}"><view>{{editorFormdata[idx]}}</view></block><block a:else><view>请选择</view></block></picker><text class="iconfont iconjiantou" style="color:#999;font-weight:normal;"></text></block></block><block a:if="{{item.$orig.key=='upload'}}"><block><input style="display:none;" type="text" name="{{'form'+idx}}" value="{{editorFormdata[idx]}}"/><view class="flex" style="flex-wrap:wrap;padding-top:20rpx;"><block a:if="{{editorFormdata[idx]}}"><view class="form-imgbox"><view class="layui-imgbox-close" style="z-index:2;" data-idx="{{idx}}" data-event-opts="{{[['tap',[['removeimg',['$event']]]]]}}" onTap="__e"><image style="display:block;" src="{{pre_url+'/static/img/ico-del.png'}}"></image></view><view class="form-imgbox-img"><image class="image" src="{{editorFormdata[idx]}}" data-url="{{editorFormdata[idx]}}" mode="aspectFit" data-event-opts="{{[['tap',[['previewImage',['$event']]]]]}}" onTap="__e"></image></view></view></block><block a:else><view class="form-uploadbtn" style="{{'background:'+('url('+pre_url+'/static/img/shaitu_icon.png) no-repeat 50rpx')+';'+('background-size:'+('80rpx 80rpx')+';')+('background-color:'+('#F3F3F3')+';')}}" data-idx="{{idx}}" data-event-opts="{{[['tap',[['editorChooseImage',['$event']]]]]}}" onTap="__e"></view></block></view></block></block><block a:if="{{item.$orig.key=='upload_pics'}}"><block><input style="display:none;" type="text" name="{{'form'+idx}}" maxlength="-1" value="{{editorFormdata&&editorFormdata[idx]?item.g1:''}}"/><view class="flex" style="flex-wrap:wrap;padding-top:20rpx;"><view class="form-imgbox" a:for="{{editorFormdata[idx]}}" a:for-item="item2" a:for-index="index2" a:key="index2"><view class="layui-imgbox-close" data-index="{{index2}}" data-type="pics" data-idx="{{idx}}" data-formidx="{{'form'+idx}}" data-event-opts="{{[['tap',[['removeimg',['$event']]]]]}}" onTap="__e"><image class="image" src="{{pre_url+'/static/img/ico-del.png'}}" data-type="pics"></image></view><view class="form-imgbox-img" style="margin-bottom:10rpx;"><image class="image" src="{{item2}}" data-url="{{item2}}" mode="aspectFit" data-idx="{{idx}}" data-event-opts="{{[['tap',[['previewImage',['$event']]]]]}}" onTap="__e"></image></view></view><view class="form-uploadbtn" style="{{'background:'+('url('+pre_url+'/static/img/shaitu_icon.png) no-repeat 50rpx')+';'+('background-size:'+('80rpx 80rpx')+';')+('background-color:'+('#F3F3F3')+';')}}" data-idx="{{idx}}" data-formidx="{{'form'+idx}}" data-type="pics" data-event-opts="{{[['tap',[['editorChooseImages',['$event']]]]]}}" onTap="__e"></view></view></block></block></view></view></view><block a:if="{{userinfo.score2money>0}}"><view class="scoredk flex"><checkbox-group data-event-opts="{{[['change',[['scoredk',['$event']]]]]}}" class="flex" style="width:100%;" onChange="__e"><view class="f1"><view>{{userinfo.score*1+" "+$root.m7+'可抵扣'}}<text style="color:#e94745;">{{userinfo.scoredk_money*1}}</text>元</view><block a:if="{{(userinfo.scoremaxtype==0||userinfo.scoremaxtype==1)&&userinfo.scoredkmaxpercent>0&&userinfo.scoredkmaxpercent<100}}"><view style="font-size:22rpx;color:#999;">{{"最多可抵扣订单金额的"+userinfo.scoredkmaxpercent+"%"}}</view></block><block a:else><block a:if="{{userinfo.scoremaxtype==2}}"><view style="font-size:22rpx;color:#999;">{{'最多可抵扣'+userinfo.scoredkmaxpercent+"元"}}</view></block></block></view><view class="f2">{{"使用"+$root.m8+'抵扣'}}<checkbox style="margin-left:6px;transform:scale(.8);" value="1"></checkbox></view></checkbox-group></view></block><view style="width:100%;height:110rpx;"></view><view class="footer flex notabbarbot"><view class="text1 flex1">总计：<text style="font-weight:bold;font-size:36rpx;">{{"￥"+totalprice}}</text></view><button class="op" style="{{'background:'+('linear-gradient(-90deg,'+$root.m9+' 0%,rgba('+$root.m10+',0.8) 100%)')+';'}}" form-type="submit">提交订单</button></view></form><block a:if="{{couponvisible}}"><view class="popup__container"><view data-event-opts="{{[['tap',[['handleClickMask',['$event']]]]]}}" class="popup__overlay" catchTap="__e"></view><view class="popup__modal"><view class="popup__title"><text class="popup__title-text">{{"请选择"+$root.m11}}</text><image class="popup__close" style="width:36rpx;height:36rpx;" src="{{pre_url+'/static/img/close.png'}}" data-event-opts="{{[['tap',[['handleClickMask',['$event']]]]]}}" catchTap="__e"></image></view><view class="popup__content"><couponlist vue-id="05e30050-1" couponlist="{{couponList}}" choosecoupon="{{true}}" selectedrid="{{couponrid}}" bid="{{product.bid}}" data-event-opts="{{[['^chooseCoupon',[['chooseCoupon']]]]}}" onChooseCoupon="__e" onVueInit="__l"></couponlist></view></view></view></block><block a:if="{{pstimeDialogShow}}"><view class="popup__container"><view data-event-opts="{{[['tap',[['hidePstimeDialog',['$event']]]]]}}" class="popup__overlay" catchTap="__e"></view><view class="popup__modal"><view class="popup__title"><text class="popup__title-text">{{"请选择"+(freightList[freightkey].pstype==1?'取货':'配送')+"时间"}}</text><image class="popup__close" style="width:36rpx;height:36rpx;" src="{{pre_url+'/static/img/close.png'}}" data-event-opts="{{[['tap',[['hidePstimeDialog',['$event']]]]]}}" catchTap="__e"></image></view><view class="popup__content"><view class="pstime-item" data-index="{{index}}" data-event-opts="{{[['tap',[['pstimeRadioChange',['$event']]]]]}}" onTap="__e" a:for="{{$root.l3}}" a:for-item="item" a:for-index="index" a:key="index"><view class="flex1">{{item.$orig.title}}</view><view class="radio" style="{{(freight_time==item.$orig.value?'background:'+item.m12+';border:0':'')}}"><image class="radio-img" src="{{pre_url+'/static/img/checkd.png'}}"></image></view></view></view></view></view></block></block></block><block a:if="{{loading}}"><loading vue-id="05e30050-2" onVueInit="__l"></loading></block><dp-tabbar vue-id="05e30050-3" opt="{{opt}}" onVueInit="__l"></dp-tabbar><popmsg vue-id="05e30050-4" ref="__r" data-ref="popmsg" onVueInit="__l"></popmsg><wxxieyi vue-id="05e30050-5" onVueInit="__l"></wxxieyi></view>