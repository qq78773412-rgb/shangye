ldsilverlist}}" a:for-item="item" a:for-index="index"><radio class="radio" style="margin-left:6px;transform:scale(.8);" checked="{{goldsilverindex==index?true:false}}" data-index="{{index}}" data-type="{{item.type}}" data-value="{{item.value}}" value="{{item.type}}" data-event-opts="{{[['tap',[['goldsilverdk',['$event']]]]]}}" onTap="__e"></radio>{{item.name+''}}</view></radio-group></view></view><view class="scoredk flex" style="margin:0;margin-bottom:0;width:100%;"><text class="f1">抵扣金额</text><text class="f2" style="color:#000;font-weight:bold;">{{"-¥"+goldsilverdec}}</text></view></view></block><block a:if="{{userinfo.dedamount>0&&userinfo.dedamount_dkmoney>0}}"><view class="scoredk"><checkbox-group data-event-opts="{{[['change',[['dedamountdk',['$event']]]]]}}" class="flex" style="width:100%;" onChange="__e"><view class="f1"><view>{{userinfo.dedamount*1+''}}<text style="font-weight:bold;">抵扣金</text>可抵扣<text style="color:#e94745;">{{userinfo.dedamount_dkmoney*1}}</text>元</view><view style="font-size:24rpx;color:#999;">选择此项提交订单时将直接扣除抵扣金</view></view><view class="f2">使用<text style="font-weight:bold;">抵扣金</text>抵扣<checkbox style="margin-left:6px;transform:scale(.8);" value="1" checked="{{usededamount}}"></checkbox></view></checkbox-group></view></block><block a:if="{{userinfo.shopscore>0&&userinfo.shopscoredk_money>0&&userinfo.shopscoredkmaxpercent>0}}"><view class="scoredk"><checkbox-group data-event-opts="{{[['change',[['shopscoredk',['$event']]]]]}}" class="flex" style="width:100%;" onChange="__e"><view class="f1"><view>{{userinfo.shopscore*1+" "+$root.m35+'可抵扣'}}<text style="color:#e94745;">{{userinfo.shopscoredk_money*1}}</text>元</view><block a:if="{{userinfo.shopscoremaxtype==0}}"><view style="font-size:22rpx;color:#999;">{{'1、最多可抵扣订单金额的'+(userinfo.shopscoredkmaxpercent<=100?userinfo.shopscoredkmaxpercent:'100')+'%'}}</view></block><block a:else><block a:if="{{userinfo.shopscoremaxtype==1}}"><view style="font-size:22rpx;color:#999;">{{'1、最多可抵扣'+userinfo.shopsc