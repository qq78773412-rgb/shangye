<view class="container"><block a:if="{{isload}}"><block><form data-event-opts="{{[['submit',[['topay',['$event']]]]]}}" onSubmit="__e"><block a:if="{{!usegiveorder}}"><block><block a:if="{{needaddress==0}}"><view class="address-add"><view class="linkitem"><view class="f1"><block a:if="{{contact_require==1||is_pingce}}"><label class="redStar">*</label></block>联系人</view><input class="input" type="text" placeholder="请输入您的姓名" placeholder-style="color:#626262;font-size:28rpx" data-event-opts="{{[['input',[['inputLinkman',['$event']]]]]}}" value="{{linkman}}" onInput="__e"/></view><block a:if="{{is_pingce}}"><view class="linkitem"><view class="f1"><block a:if="{{contact_require==1||is_pingce}}"><label class="redStar">*</label></block>性 别</view><picker class="input" mode="selector" range="{{sexlist}}" data-event-opts="{{[['change',[['bindPickerChangeSex',['$event']]]]]}}" onChange="__e"><block a:if="{{gender}}"><view>{{''+gender}}</view></block><block a:else><view>请选择</view></block></picker></view></block><view class="linkitem"><view class="f1"><block a:if="{{contact_require==1||is_pingce}}"><label class="redStar">*</label></block>联系电话</view><input class="input" type="text" placeholder="请输入您的手机号" placeholder-style="color:#626262;font-size:28rpx" data-event-opts="{{[['input',[['inputTel',['$event']]]]]}}" value="{{tel}}" onInput="__e"/></view><block a:if="{{worknum_status}}"><view class="linkitem"><view class="f1"><label class="redStar"></label>工 号</view><input class="input" type="number" placeholder="{{worknumtip}}" placeholder-style="color:#626262;font-size:28rpx" data-event-opts="{{[['input',[['inputWorknum',['$event']]]]]}}" value="{{worknum}}" onInput="__e"/></view></block><block a:if="{{is_pingce}}"><view class="linkitem"><view class="f1"><block a:if="{{contact_require==1||is_pingce}}"><label class="redStar">*</label></block>邮 箱</view><input class="input" type="text" placeholder="请输入您的邮箱" placeholder-style="color:#626262;font-size:28rpx" data-event-opts="{{[['input',[['inputEmail',['$event']]]]]}}" value="{{pcemail}}" onInput="__e"/></view></block><block a:if="{{is_pingce}}"><view class="linkitem"><view class="f1"><label class="redStar">*</label>生 日</view><picker class="input" mode="date" end="{{endDate}}" data-event-opts="{{[['change',[['editorBindPickerChangeAge',['$event']]]]]}}" onChange="__e"><block a:if="{{age}}"><view>{{''+age}}</view></block><block a:else><view>请选择</view></block></picker><text class="iconfont iconjiantou" style="color:#999;font-weight:normal;"></text></view></block><block a:if="{{is_pingce}}"><view class="linkitem"><view class="f1"><label class="redStar">*</label>院 校</view><input class="input" type="text" placeholder="请输入您的院校" placeholder-style="color:#626262;font-size:28rpx" data-event-opts="{{[['input',[['inputSchool',['$event']]]]]}}" onInput="__e"/></view></block><block a:if="{{is_pingce}}"><view class="linkitem"><view class="f1"><label class="redStar"></label>院 系</view><input class="input" type="text" placeholder="请输入您的院系" placeholder-style="color:#626262;font-size:28rpx" data-event-opts="{{[['input',[['inputFaculties',['$event']]]]]}}" onInput="__e"/></view></block><block a:if="{{is_pingce}}"><view class="linkitem"><view class="f1"><label class="redStar">*</label>专 业</view><input class="input" type="text" placeholder="请输入您的专业" placeholder-style="color:#626262;font-size:28rpx" data-event-opts="{{[['input',[['inputMajor',['$event']]]]]}}" onInput="__e"/></view></block><block a:if="{{is_pingce}}"><view class="linkitem"><view class="f1"><label class="redStar">*</label>学 历</view><picker class="input" mode="selector" range="{{edulist}}" data-event-opts="{{[['change',[['bindPickerChangeEdu',['$event']]]]]}}" onChange="__e"><block a:if="{{education}}"><view>{{''+education}}</view></block><block a:else><view>请选择</view></block></picker><text class="iconfont iconjiantou" style="color:#999;font-weight:normal;"></text></view></block><block a:if="{{is_pingce}}"><view class="linkitem"><view class="f1"><label class="redStar">*</label>入学年份</view><picker class="input" mode="date" fields="year" data-event-opts="{{[['change',[['editorBindPickerChangeEnrol',['$event']]]]]}}" onChange="__e"><block a:if="{{enrol}}"><view>{{enrol}}</view></block><block a:else><view>请选择</view></block></picker><text class="iconfont iconjiantou" style="color:#999;font-weight:normal;"></text></view></block><block a:if="{{is_pingce}}"><view class="linkitem"><view class="f1"><label class="redStar"></label>班 级</view><input class="input" type="text" placeholder="请输入您的班级" placeholder-style="color:#626262;font-size:28rpx" data-event-opts="{{[['input',[['inputClassName',['$event']]]]]}}" onInput="__e"/></view></block></view></block><block a:else><view class="address-add flex-y-center"><view class="flex-y-center " style="flex:1;" data-url="{{'/pagesB/address/'+(address.id?'address':'addressadd')+'?fromPage=buy&source=shop&type='+(havetongcheng==1?'1':'0')}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" onTap="__e"><image class="img" style="width:66rpx;height:66rpx;margin-right:20rpx;" src="{{pre_url+'/static/img/address.png'}}"></image><block a:if="{{address.id}}"><view class="f2" style="flex:1;"><view style="font-weight:bold;color:#111111;font-size:30rpx;">{{address.name+" "+address.tel+''}}<block a:if="{{address.company}}"><text>{{address.company}}</text></block></view><view style="font-size:24rpx;">{{address.area+" "+address.address}}</view></view></block><block a:else><view class="f2 flex1">请选择收货地址</view></block><image class="f3" src="{{pre_url+'/static/img/arrowright.png'}}"></image></view><block a:if="{{worknum_status}}"><view class="linkitem" style="margin:20rpx;line-height:50rpx;"><text class="f1" style="width:90rpx;margin-right:0;">工号</text><input class="input" type="text" placeholder="{{worknumtip}}" placeholder-style="color:#626262;font-size:28rpx" data-event-opts="{{[['input',[['inputWorknum',['$event']]]]]}}" value="{{worknum}}" onInput="__e"/></view></block><block a:if="{{needusercard}}"><view class="linkitem" style="margin:20rpx;line-height:50rpx;"><text class="f1" style="width:140rpx;margin-right:0;">身份证号</text><input class="input" type="text" placeholder="{{usercardtip}}" placeholder-style="color:#626262;font-size:28rpx" data-event-opts="{{[['input',[['inputWorknum',['$event']]]]]}}" value="{{usercard}}" onInput="__e"/></view></block></view></block></block></block><block a:if="{{show_other_order}}"><view class="scoredk"><view class="price"><view class="f1">选择下单会员</view><view data-event-opts="{{[['tap',[['showTeamMemberList',['$event']]]]]}}" class="f2 flex" style="align-items:center;justify-content:flex-end;" onTap="__e"><image style="width:50rpx;height:50rpx;border-radius:50%;margin-right:10rpx;" src="{{teamMember.headimg}}" alt class="_img"></image><text>{{teamMember.id?teamMember.nickname+'(ID:'+teamMember.id+')':'请选择'}}</text><text class="iconfont iconjiantou" style="color:#999;font-weight:normal;"></text></view></view></view></block><view class="buydata" a:for="{{$root.l7}}" a:for-item="buydata" a:for-index="groupBid" a:key="groupBid"><view class="btitle"><image class="img" src="{{pre_url+'/static/img/ico-shop.png'}}"></image>{{buydata.$orig.business.name+''}}</view><view class="bcontent"><view class="product"><view a:for="{{buydata.l1}}" a:for-item="item" a:for-index="index2" a:key="index2"><view class="item flex"><view class="img" data-url="{{'/pages/shop/product?id='+item.$orig.product.id}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" onTap="__e"><block a:if="{{item.$orig.guige.pic}}"><image src="{{item.$orig.guige.pic}}"></image></block><block a:else><block a:if="{{item.$orig.guige.ggpic_wholesale}}"><image src="{{item.$orig.guige.ggpic_wholesale}}"></image></block><block a:else><image src="{{item.$orig.product.pic}}"></image></block></block></view><view class="info flex1"><view class="f1">{{item.$orig.product.name}}</view><view class="f2">{{"规格："+(item.$orig.guige.gg_group_title?item.$orig.guige.gg_group_title:'')+" "+item.$orig.guige.name}}</view><block a:if="{{item.$orig.product.product_type==3}}"><view class="f2">{{"手工费："+item.$orig.guige.hand_fee}}</view></block><view class="f3"><block a:if="{{order_change_price}}"><block><input class="inputPrice" type="number" data-price="{{item.$orig.guige.sell_price}}" data-index="{{groupBid}}" data-index2="{{index2}}" data-event-opts="{{[['input',[['inputPrice',['$event']]]]]}}" value="{{item.$orig.guige.sell_price}}" onInput="__e"/></block></block><block a:else><block><text style="font-weight:bold;">{{"￥"+item.$orig.guige.sell_price}}<block a:if="{{item.m0}}"><text>{{"+"+item.$orig.guige.service_fee+item.m1}}</text></block></text></block></block><text style="padding-left:20rpx;">{{'× '+item.$orig.num}}</text></view></view></view><block a:if="{{item.$orig.product.weighttype>0&&item.$orig.product.weightlist.length>0}}"><view class="freight"><view class="f1">{{''+item.m2}}</view><view class="freight-ul"><view style="width:100%;overflow-y:hidden;overflow-x:scroll;white-space:nowrap;"><block a:for="{{item.l0}}" a:for-item="item1" a:for-index="idx3" a:key="idx3"><view class="freight-li" style="{{(item.$orig.product.weightkey==idx3?'color:'+item1.m3+';background:rgba('+item1.m4+',0.2)':'')}}" data-bid="{{groupBid}}" data-proindex="{{index2}}" data-index="{{idx3}}" data-event-opts="{{[['tap',[['changeWeight',['$event']]]]]}}" onTap="__e">{{item1.$orig.name+''}}</view></block></view></view></view></block><block a:if="{{item.$orig.product.product_type==1}}"><view class="glassinfo" style="{{('background:rgba('+item.m5+',0.8);color:#FFF')}}" data-index="{{groupBid}}" data-index2="{{index2}}" data-grid="{{item.$orig.product.has_glassrecord==1?item.$orig.product.glassrecord.id:0}}" data-event-opts="{{[['tap',[['showglass',['$event']]]]]}}" onTap="__e"><view class="f1">视力档案</view><view class="f2"><text>{{item.$orig.product.has_glassrecord==1?item.$orig.product.glassrecord.name:''}}</text><image src="{{pre_url+'/static/img/arrowright.png'}}"></image></view></view></block></view></view><block a:if="{{!usegiveorder}}"><block><view class="freight"><view class="f1">配送方式</view><view class="freight-ul"><view style="width:100%;overflow-y:hidden;overflow-x:scroll;white-space:nowrap;"><block a:for="{{buydata.l2}}" a:for-item="item" a:for-index="idx2" a:key="idx2"><view class="freight-li" style="{{(buydata.$orig.freightkey==idx2?'color:'+item.m6+';background:rgba('+item.m7+',0.2)':'')}}" data-bid="{{groupBid}}" data-index="{{idx2}}" data-event-opts="{{[['tap',[['changeFreight',['$event']]]]]}}" onTap="__e">{{item.$orig.name+''}}</view></block></view></view><block a:if="{{buydata.$orig.freightList[buydata.$orig.freightkey].minpriceset==1&&buydata.$orig.freightList[buydata.$orig.freightkey].minprice>0&&buydata.$orig.freightList[buydata.$orig.freightkey].minprice*1>buydata.$orig.product_price*1}}"><view class="freighttips">{{'满'+buydata.$orig.freightList[buydata.$orig.freightkey].minprice+"元起送，还差"+buydata.g0+'元'}}</view></block><block a:if="{{buydata.$orig.freightList[buydata.$orig.freightkey].isoutjuli==1}}"><view class="freighttips">超出配送范围</view></block><block a:if="{{buydata.$orig.freightList[buydata.$orig.freightkey].desc}}"><view class="freighttips">{{buydata.$orig.freightList[buydata.$orig.freightkey].desc}}</view></block></view><block a:if="{{buydata.$orig.freightList[buydata.$orig.freightkey].pstimeset==1}}"><view class="price"><view class="f1">{{(buydata.$orig.freightList[buydata.$orig.freightkey].pstype==1?'取货':'配送')+"时间"}}</view><view class="f2" data-bid="{{groupBid}}" data-event-opts="{{[['tap',[['choosePstime',['$event']]]]]}}" onTap="__e">{{''+(buydata.$orig.pstimetext==''?'请选择时间':buydata.$orig.pstimetext)}}<text class="iconfont iconjiantou" style="color:#999;font-weight:normal;"></text></view></view></block><block a:if="{{buydata.$orig.freightList[buydata.$orig.freightkey].pstype==1&&buydata.$orig.freightList[buydata.$orig.freightkey].isbusiness==1}}"><view class="storeitem"><view class="panel"><view class="f1">取货地点</view></view><block a:for="{{buydata.$orig.freightList[buydata.$orig.freightkey].storedata}}" a:for-item="item" a:for-index="idx" a:key="idx"><block a:if="{{idx<5||storeshowall==true}}"><view class="radio-item" data-freightkey="{{buydata.$orig.freightkey}}" data-storekey="{{idx}}" data-bid="{{groupBid}}" data-index="{{idx}}" data-event-opts="{{[['tap',[['openLocation',['$event']]]]]}}" onTap="__e"><view class="f1"><view>{{item.name}}</view><block a:if="{{item.address}}"><view style="text-align:left;font-size:24rpx;color:#aaaaae;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:1;overflow:hidden;">{{item.address}}</view></block></view><text style="color:#f50;">{{item.juli}}</text></view></block></block><block a:if="{{storeshowall==false&&buydata.$orig.freightList[buydata.$orig.freightkey].storedata.length>5}}"><view data-event-opts="{{[['tap',[['doStoreShowAll',['$event']]]]]}}" class="storeviewmore" onTap="__e">- 查看更多 -</view></block></view></block><block a:if="{{!mendianShowType}}"><view><block a:if="{{buydata.$orig.freightList[buydata.$orig.freightkey].pstype==1&&buydata.$orig.freightList[buydata.$orig.freightkey].isbusiness!=1}}"><view class="storeitem"><block a:if="{{mendian_no_select==0}}"><block><view class="panel"><view class="f1">取货地点</view><block a:if="{{buydata.$orig.freightList[buydata.$orig.freightkey].storedata.length>0}}"><view class="f2" data-bid="{{buydata.$orig.bid}}" data-freightkey="{{buydata.$orig.freightkey}}" data-storekey="{{buydata.$orig.freightList[buydata.$orig.freightkey].storekey}}" data-event-opts="{{[['tap',[['openMendian',['$event']]]]]}}" onTap="__e"><text class="iconfont icondingwei"></text>{{''+buydata.$orig.freightList[buydata.$orig.freightkey].storedata[buydata.$orig.freightList[buydata.$orig.freightkey].storekey].name+''}}</view></block><block a:else><view class="f2">暂无</view></block></view></block></block><block a:else><block><view class="panel"><view class="f1">可使用门店</view></view></block></block><block a:if="{{mendian_upgrade}}"><block><block a:for="{{buydata.$orig.freightList[buydata.$orig.freightkey].storedata}}" a:for-item="item" a:for-index="idx" a:key="idx"><view data-event-opts="{{[['tap',[['gotoMendianList',['$event']]]]]}}" class="radio-item" style="border:10rpx solid #f6f6f6;border-radius:10rpx;padding:10rpx;" onTap="__e"><view class="headimg"><image src="{{item.headimg}}"></image></view><view class="f1" style="display:flex;justify-content:space-between;align-items:center;"><view><view>{{item.xqname}}</view><block a:if="{{item.address}}"><view class="flex-y-center" style="text-align:left;font-size:24rpx;color:#aaaaae;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:1;overflow:hidden;">{{"领取地址："+item.address}}</view></block></view><block a:if="{{mendian_change}}"><view><text class="iconfont iconjiantou" style="color:#999;font-weight:normal;"></text></view></block></view></view></block></block></block><block a:else><block a:if="{{mendian_no_select}}"><block><block a:for="{{buydata.$orig.freightList[buydata.$orig.freightkey].storedata}}" a:for-item="item" a:for-index="idx" a:key="idx"><block a:if="{{idx<5||storeshowall==true}}"><view class="radio-item" data-bid="{{buydata.$orig.bid}}" data-index="{{idx}}"><view class="f1"><view>{{item.name}}</view><block a:if="{{item.address}}"><view class="flex-y-center" style="text-align:left;font-size:24rpx;color:#aaaaae;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:1;overflow:hidden;">{{item.address}}</view></block></view><text style="color:#f50;">{{item.juli}}</text></view></block></block></block></block><block a:else><block><block a:for="{{buydata.l3}}" a:for-item="item" a:for-index="idx" a:key="idx"><block a:if="{{idx<5||storeshowall==true}}"><view class="radio-item" data-bid="{{groupBid}}" data-index="{{idx}}" data-event-opts="{{[['tap',[['choosestore',['$event']]]]]}}" catchTap="__e"><view class="f1"><view>{{item.$orig.name}}</view><block a:if="{{item.$orig.address}}"><view class="flex-y-center" style="text-align:left;font-size:24rpx;color:#aaaaae;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:1;overflow:hidden;">{{item.$orig.address}}</view></block></view><text style="color:#f50;">{{item.$orig.juli}}</text><view class="radio" style="{{(buydata.$orig.freightList[buydata.$orig.freightkey].storekey==idx?'background:'+item.m8+';border:0':'')}}"><image class="radio-img" src="{{pre_url+'/static/img/checkd.png'}}"></image></view></view></block></block></block></block></block><block a:if="{{storeshowall==false&&buydata.$orig.freightList[buydata.$orig.freightkey].storedata.length>5}}"><view data-event-opts="{{[['tap',[['doStoreShowAll',['$event']]]]]}}" class="storeviewmore" onTap="__e">- 查看更多 -</view></block></view></block><block a:if="{{buydata.$orig.freightList[buydata.$orig.freightkey].pstype==2&&buydata.$orig.freightList[buydata.$orig.freightkey].storedata}}"><view class="storeitem"><view class="panel"><view class="f1">门店</view><block a:if="{{buydata.$orig.freightList[buydata.$orig.freightkey].storedata.length>0}}"><view class="f2" data-bid="{{groupBid}}" data-freightkey="{{buydata.$orig.freightkey}}" data-storekey="{{buydata.$orig.freightList[buydata.$orig.freightkey].storekey}}" data-event-opts="{{[['tap',[['openMendian',['$event']]]]]}}" onTap="__e"><text class="iconfont icondingwei"></text>{{buydata.$orig.freightList[buydata.$orig.freightkey].storedata[buydata.$orig.freightList[buydata.$orig.freightkey].storekey].name+''}}</view></block><block a:else><view class="f2">暂无</view></block></view><block a:for="{{buydata.l4}}" a:for-item="item" a:for-index="idx" a:key="idx"><block a:if="{{idx<5||storeshowall==true}}"><view class="radio-item" data-bid="{{groupBid}}" data-index="{{idx}}" data-event-opts="{{[['tap',[['choosestore',['$event']]]]]}}" catchTap="__e"><view class="f1"><view>{{item.$orig.name}}</view><block a:if="{{item.$orig.address}}"><view style="text-align:left;font-size:24rpx;color:#aaaaae;display:-webkit-box;-webkit-box-o