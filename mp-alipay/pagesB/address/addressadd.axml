<view class="container"><block a:if="{{isload}}"><block><form data-event-opts="{{[['submit',[['formSubmit',['$event']]]]]}}" onSubmit="__e"><view class="form"><view class="form-item"><text class="label">姓 名</text><input class="input" type="text" placeholder="请输入姓名" placeholder-style="font-size:28rpx;color:#BBBBBB" name="name" value="{{name}}"/></view><block a:if="{{showCompany}}"><view class="form-item"><text class="label">公 司</text><input class="input" type="text" placeholder="请输入公司或单位名称" placeholder-style="font-size:28rpx;color:#BBBBBB" name="company" value="{{company}}"/></view></block><view class="form-item"><text class="label">手机号</text><input class="input" type="number" placeholder="请输入手机号" placeholder-style="font-size:28rpx;color:#BBBBBB" name="tel" value="{{tel}}"/></view><block a:if="{{type==1}}"><view class="form-item"><text class="label flex0">选择位置</text><text data-event-opts="{{[['tap',[['selectzuobiao',['$event']]]]]}}" class="flex1" style="{{'text-align:right;'+(area?'':'color:#BBBBBB')}}" onTap="__e">{{area?area:'请选择您的位置'}}</text></view></block><block a:else><view class="form-item"><text class="label flex1">所在地区</text><uni-data-picker vue-id="23aebefe-1" localdata="{{items}}" border="{{false}}" placeholder="{{regiondata||'请选择省市区'}}" data-event-opts="{{[['^change',[['regionchange']]]]}}" onChange="__e" onVueInit="__l"></uni-data-picker></view></block><view class="form-item"><text class="label">{{$root.m0}}</text><input class="input" type="text" placeholder="{{'请输入'+$root.m1}}" placeholder-style="font-size:28rpx;color:#BBBBBB" name="address" value="{{address}}"/></view><block a:if="{{type!=1}}"><view class="item flex-y-center"><view class="f2 flex-y-center flex1"><textarea style="width:85%;font-size:24rpx;margin:20rpx 0;height:100rpx;padding:4rpx 10rpx;" id="addressxx" placeholder="粘贴地址信息，可自动识别并填写，如：张三，188********，广东省 东莞市 xx区 xx街道 xxxx" placeholder-style="font-size:24rpx;color:#BBBBBB" data-event-opts="{{[['input',[['setaddressxx',['$event']]]]]}}" onInput="__e"></textarea><view data-event-opts="{{[['tap',[['shibie',['$event']]]]]}}" style="width:15%;text-align:center;" onTap="__e">识别</view></view></view></block></view><block a:if="{{product_thali}}"><view class="form"><view class="form-item"><text class="label">学生姓名</text><input class="input" style="width:650rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" type="text" placeholder="请输入学生姓名" placeholder-style="font-size:28rpx;color:#BBBBBB" name="product_thali_student_name" value="{{product_thali_student_name}}"/></view><block a:if="{{schooldata&&!schoolAreaText}}"><view class="form-item"><text class="label flex1" style="white-space:nowrap;">学校信息</text><picker range="{{schoolArea}}" range-key="name" data-event-opts="{{[['change',[['PickerSchoolArea',['$event']]]]]}}" onChange="__e"><view class="flex1 schooldata-class">{{schooldata}}</view></picker></view></block><block a:else><view class="form-item"><text class="label flex1">学校区域</text><picker range="{{schoolArea}}" range-key="name" data-event-opts="{{[['change',[['PickerSchoolArea',['$event']]]]]}}" onChange="__e"><block a:if="{{schoolAreaText}}"><view class="picker-select">{{schoolAreaText}}</view></block><block a:else><view class="picker-placeholder">请选择区域</view></block></picker></view></block><block a:if="{{schoolList.length&&schoolAreaText}}"><view class="form-item"><text class="label flex1">学校信息</text><picker range="{{schoolList}}" range-key="name" data-event-opts="{{[['change',[['PickerSchoolList',['$event']]]]]}}" onChange="__e"><block a:if="{{schoolText}}"><view class="picker-select">{{schoolText}}</view></block><block a:else><view class="picker-placeholder">请选择学校</view></block></picker></view></block><block a:if="{{studentGradeList.length&&schoolText}}"><view class="form-item"><text class="label flex1">学生年级</text><picker range="{{studentGradeList}}" range-key="name" data-event-opts="{{[['change',[['PickerStudentGrade',['$event']]]]]}}" onChange="__e"><block a:if="{{studentGradeText}}"><view class="picker-select">{{studentGradeText}}</view></block><block a:else><view class="picker-placeholder">请选择学生年级</view></block></picker></view></block><block a:if="{{studentClassList.length&&studentGradeText}}"><view class="form-item"><text class="label flex1">学生班级</text><picker range="{{studentClassList}}" range-key="name" data-event-opts="{{[['change',[['PickerstudentClass',['$event']]]]]}}" onChange="__e"><block a:if="{{studentClassText}}"><view class="picker-select">{{studentClassText}}</view></block><block a:else><view class="picker-placeholder">请选择学生班级</view></block></picker></view></block></view></block><button class="savebtn" style="{{('background:linear-gradient(90deg,'+$root.m2+' 0%,rgba('+$root.m3+',0.8) 100%)')}}" form-type="submit">保 存</button></form></block></block><block a:if="{{loading}}"><loading vue-id="23aebefe-2" onVueInit="__l"></loading></block><dp-tabbar vue-id="23aebefe-3" opt="{{opt}}" onVueInit="__l"></dp-tabbar><popmsg vue-id="23aebefe-4" ref="__r" data-ref="popmsg" onVueInit="__l"></popmsg><wxxieyi vue-id="23aebefe-5" onVueInit="__l"></wxxieyi></view>