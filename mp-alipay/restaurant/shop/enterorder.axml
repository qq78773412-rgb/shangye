<view class="container"><block a:if="{{isload}}"><block><view class="address-add flex-y-center"><view class="f1">桌台信息</view><block a:if="{{tableinfo.id}}"><view class="f2 flex1"><view style="font-weight:bold;color:#111111;font-size:30rpx;">{{tableinfo.name}}<text style="font-size:24rpx;font-weight:normal;color:#666;margin-left:10rpx;">{{tableinfo.seat+"人桌"}}</text></view></view></block><block a:else><view class="f2 flex1">请扫描桌台二维码</view></block><image class="f3" src="{{pre_url+'/static/img/arrowright.png'}}"></image></view><view class="buydata" a:for="{{$root.l1}}" a:for-item="buydata" a:for-index="index" a:key="index"><view class="buystatus flex flex-y-center"><view class="leftline" style="{{'background-color:'+($root.m0)+';'}}"></view>待下单</view><view class="bcontent"><view class="product"><block a:for="{{buydata.l0}}" a:for-item="item" a:for-index="index2" a:key="index2"><block a:if="{{index2<4||waitordershowall==true}}"><view class="item flex"><view class="img" data-url="{{'product?id='+item.$orig.product.id}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" onTap="__e"><image src="{{item.$orig.product.pic}}"></image></view><view class="info flex1"><view class="f1">{{item.$orig.product.name}}</view><block a:if="{{item.$orig.guige.name}}"><view class="f2">{{"规格："+item.$orig.guige.name+item.$orig.jldata.jltitle+''}}<block a:if="{{item.$orig.jldata.njltitle}}"><text>{{"（"+item.$orig.jldata.njltitle+")"}}</text></block></view></block><block a:if="{{item.$orig.guige.ggtext&&item.$orig.guige.ggtext.length>0}}"><view class="f2"><view a:for="{{item.$orig.guige.ggtext}}" a:for-item="gitem" a:for-index="index">{{gitem}}</view></view></block><view class="f3"><text style="font-weight:bold;">{{'￥'+item.g0+''}}<block a:if="{{item.$orig.product.product_type&&item.$orig.product.product_type==1}}"><text style="font-size:20rpx;">/斤</text></block></text><text style="padding-left:20rpx;">{{'× '+item.$orig.num}}</text><block a:if="{{item.$orig.product.product_type&&item.$orig.product.product_type==1}}"><text style="font-size:20rpx;">斤</text></block></view></view></view></block></block><block a:if="{{waitordershowall==false&&buydata.$orig.prodata.length>4}}"><view data-event-opts="{{[['tap',[['doWaitorderShowAll',['$event']]]]]}}" class="storeviewmore" onTap="__e">- 查看更多 -</view></block></view></view></view><view class="buydata" a:for="{{$root.l3}}" a:for-item="buydata" a:for-index="index"><view class="buystatus flex flex-y-center"><view class="leftline" style="{{'background-color:'+($root.m1)+';'}}"></view>已下单</view><view class="bcontent"><view class="product"><block a:for="{{buydata.l2}}" a:for-item="item" a:for-index="index2" a:key="index2"><block a:if="{{index2<4||ordershowall==true}}"><view class="item flex"><view class="img" data-url="{{'product?id='+item.$orig.proid}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" onTap="__e"><image src="{{item.$orig.pic}}"></image></view><view class="info flex1"><view class="f1">{{item.$orig.name}}</view><block a:if="{{item.$orig.ggname}}"><view class="f2">{{"规格："+item.$orig.ggname}}<block a:if="{{item.$orig.njltitle}}"><text>{{"（"+item.$orig.njltitle+")"}}</text></block></view></block><view class="f3"><text style="font-weight:bold;">{{'￥'+item.g1+''}}<block a:if="{{item.$orig.product.product_type&&item.$orig.product.product_type==1}}"><text style="font-size:20rpx;">/斤</text></block></text><text style="padding-left:20rpx;">{{'× '+item.$orig.num}}</text><block a:if="{{item.$orig.product.product_type&&item.$orig.product.product_type==1}}"><text style="font-size:20rpx;">斤</text></block></view></view></view></block></block><block a:if="{{ordershowall==false&&buydata.$orig.prodata.length>4}}"><view data-event-opts="{{[['tap',[['doOrderShowAll',['$event']]]]]}}" class="storeviewmore" onTap="__e">- 查看更多 -</view></block></view></view></view><view style="width:100%;height:182rpx;"></view><view class="{{((('bottombar')+' '+'flex-row')+' '+(menuindex>-1?'tabbarbot':'notabbarbot'))}}"><view data-event-opts="{{[['tap',[['goback',['$event']]]]]}}" class="btn" onTap="__e">继续点餐</view><view data-event-opts="{{[['tap',[['toBuy',['$event']]]]]}}" class="btn " style="{{'background-color:'+($root.m2)+';'+('border-color:'+($root.m3)+';')+('color:'+('#fff')+';')}}" onTap="__e">现在下单</view></view></block></block><block a:if="{{loading}}"><loading vue-id="51f4d351-1" onVueInit="__l"></loading></block><dp-tabbar vue-id="51f4d351-2" opt="{{opt}}" onVueInit="__l"></dp-tabbar></view>