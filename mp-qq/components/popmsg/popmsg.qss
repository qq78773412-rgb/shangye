.popmsg{width:100%;height:100rpx;background:rgba(0,0,0,.7);position:fixed;z-index:999;color:#fff;font-size:28rpx;top:-100rpx;text-align:left;padding:15rpx 20rpx;overflow:hidden;display:none}.popmsg-show{display:flex;top:0rpx;-webkit-animation:popmsg-show .2s;animation:popmsg-show .2s;-webkit-animation-timing-function:ease;animation-timing-function:ease}@-webkit-keyframes popmsg-show{from{top:-100rpx}to{top:0rpx}}@keyframes popmsg-show{from{top:-100rpx}to{top:0rpx}}.popmsg-hide{top:-100rpx;-webkit-animation:popmsg-hide .2s;animation:popmsg-hide .2s;-webkit-animation-timing-function:ease;animation-timing-function:ease}@-webkit-keyframes popmsg-hide{from{top:0rpx}to{top:-100rpx}}@keyframes popmsg-hide{from{top:0rpx}to{top:-100rpx}}.popmsg-pic{width:70rpx;height:70rpx;border-radius:8rpx;margin-right:10rpx}.popmsg-content{flex:1;display:flex;flex-direction:column;justify-content:center;overflow:hidden}.popmsg-content-title{height:40rpx;line-height:40rpx;font-weight:700;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:1;overflow:hidden}.popmsg-content-desc{color:#eee;height:30rpx;line-height:30rpx;font-size:20rpx;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:1;overflow:hidden}.popmsg-close{margin-top:6rpx;width:50rpx;height:50rpx;border-radius:50%;border:1px solid #aaa;display:flex;align-items:center;justify-content:center;opacity:.7}.popmsg-close-img{width:22rpx;height:22rpx}