<view><block qq:if="{{isload}}"><block><view class="banner" style="{{'background:'+($root.m0)+';'}}"></view><view class="topsearch "><view class="f1 flex-y-center"><image class="img" src="{{pre_url+'/static/img/search_ico.png'}}"></image><view class="city" data-url="searchlist" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" bindtap="__e">{{city1?city1:city}}</view><input placeholder="输入社区名称" placeholder-style="font-size:24rpx;color:#C2C2C2" data-event-opts="{{[['confirm',[['searchConfirm',['$event']]]]]}}" value="{{keyword}}" bindconfirm="__e"/></view><view class="title">当前社区</view></view><view class="currentshequ"><view class="border"><view class="headimg"><image src="{{mendian.headimg}}"></image></view><view class="name">{{mendian.name}}</view><view class="xqname">{{mendian.xqname}}</view><view class="address">{{mendian.address}}</view></view></view><view style="height:500rpx;"></view><view class="storeitem"><view class="title">附近社区</view><block qq:for="{{datalist}}" qq:for-item="item" qq:for-index="index"><view class="radio-item" data-index="{{index}}" data-id="{{item.id}}" data-event-opts="{{[['tap',[['changeMendian',['$event']]]]]}}" catchtap="__e"><view class="headimg"><image src="{{item.pic}}"></image></view><view class="f1"><view class="f11"><view><view>{{''+item.xqname}}</view><view style="color:#aaaaae;font-size:26rpx;margin-top:10rpx;">{{$root.m1+"："+item.name}}</view></view><text class="juli">{{item.distance}}</text></view><view class="address" data-address="{{item.address}}" data-longitude="{{item.longitude}}" data-latitude="{{item.latitude}}" data-event-opts="{{[['tap',[['toMendian',['$event']]]]]}}" catchtap="__e"><view class="address2"><block qq:if="{{item.province!='北京市'||item.province!='上海市'||item.province!='重庆市'||item.province!='天津市'}}"><text>{{item.province}}</text></block>{{item.city+item.district}}<block qq:if="{{item.address}}"><text>{{item.address}}</text></block></view><image style="display:inline-block;width:26rpx;height:26rpx;" src="{{pre_url+'/static/img/arrowright.png'}}"></image></view></view></view></block></view></block></block><block qq:if="{{loading}}"><loading vue-id="060b9fa7-1" bind:__l="__l"></loading></block><block qq:if="{{nodata}}"><nodata vue-id="060b9fa7-2" bind:__l="__l"></nodata></block><block qq:if="{{nomore}}"><nomore vue-id="060b9fa7-3" bind:__l="__l"></nomore></block><dp-tabbar vue-id="060b9fa7-4" opt="{{opt}}" data-event-opts="{{[['^getmenuindex',[['getmenuindex']]]]}}" bind:getmenuindex="__e" bind:__l="__l"></dp-tabbar><popmsg class="vue-ref" vue-id="060b9fa7-5" data-ref="popmsg" bind:__l="__l"></popmsg></view>