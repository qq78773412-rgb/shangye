 class="t1">{{item2.name}}</text><block qq:if="{{item2.ggname}}"><text class="t2" style="color:#666;">{{"规格："+item2.ggname}}</text></block><block qq:else><text class="t2">{{"市场价￥"+item2.sell_price}}</text></block><view class="t3"><text class="x1 flex1"><block qq:if="{{item2.money_price>0}}"><text>{{"￥"+item2.money_price+"+"}}</text></block>{{item2.score_price+item.m0}}</text><text class="x2">{{"×"+item2.num}}</text></view></view></view></block></block><view class="bottom"><text>{{"共计"+item.$orig.procount+"件商品 实付:￥"+item.$orig.totalprice}}</text><block qq:if="{{item.$orig.refund_status==1}}"><text style="color:red;">{{'退款中￥'+item.$orig.refund_money}}</text></block><block qq:if="{{item.$orig.refund_status==2}}"><text style="color:red;">{{'已退款￥'+item.$orig.refund_money}}</text></block><block qq:if="{{item.$orig.refund_status==3}}"><text style="color:red;">退款申请已驳回</text></block></view><view class="op"><view class="btn2" data-url="{{'orderdetail?id='+item.$orig.id}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" catchtap="__e">详情</view><block qq:if="{{item.$orig.status==0}}"><block><view class="btn2" data-id="{{item.$orig.id}}" data-event-opts="{{[['tap',[['toclose',['$event']]]]]}}" catchtap="__e">关闭订单</view><view class="btn1" style="{{'background:'+(item.m1)+';'}}" data-url="{{'/pagesExt/pay/pay?id='+item.$orig.payorderid}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" catchtap="__e">去付款</view></block></block><block qq:if="{{item.$orig.status==1&&show_refund==1}}"><block><block qq:if="{{item.$orig.paytypeid!='4'}}"><block><block qq:if="{{item.$orig.refund_status==0||item.$orig.refund_status==3}}"><view class="btn2" data-url="{{'refund?orderid='+item.$orig.id+'&price='+item.$orig.totalprice+'&score='+item.$orig.totalscore}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" catchtap="__e">申请退款</view></block></block></block><block qq:else><block></block></block></block></block><block qq:if="{{item.$orig.status==2}}"><block><block qq:if="{{item.$orig.paytypeid!='4'&&show_refund==1}}"><block><block qq:if="{{item.$orig.refund_status==0||item.$orig.refund_status==3}}"><view class="btn2" data-url="{{'refund?orderid='+item.$orig.id+'&price='+item.$orig.totalprice+'&score='+item.$orig.totalscore}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" catchtap="__e">申请退款</view></block></block></block><block qq:else><block></block></block><block qq:if="{{item.$orig.freight_type!=3&&item.$orig.freight_type!=4}}"><view class="btn2" data-url="{{'/pagesExt/order/logistics?express_com='+item.$orig.express_com+'&express_no='+item.$orig.express_no}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" catchtap="__e">查看物流</view></block><block qq:if="{{item.$orig.paytypeid!='4'&&!item.$orig.type}}"><view class="btn1" style="{{'background:'+(item.m2)+';'}}" data-id="{{item.$orig.id}}" data-event-opts="{{[['tap',[['orderCollect',['$event']]]]]}}" catchtap="__e">确认收货</view></block></block></block><block qq:if="{{item.$orig.status==3||item.$orig.status==4}}"><block><view class="btn2" data-id="{{item.$orig.id}}" data-event-opts="{{[['tap',[['todel',['$event']]]]]}}" catchtap="__e">删除订单</view></block></block></view></view></block></block></view><block qq:if="{{nomore}}"><nomore vue-id="387e057d-2" bind:__l="__l"></nomore></block><block qq:if="{{nodata}}"><nodata vue-id="387e057d-3" bind:__l="__l"></nodata></block></block></block><block qq:if="{{loading}}"><loading vue-id="387e057d-4" bind:__l="__l"></loading></block><dp-tabbar vue-id="387e057d-5" opt="{{opt}}" bind:__l="__l"></dp-tabbar><popmsg class="vue-ref" vue-id="387e057d-6" data-ref="popmsg" bind:__l="__l"></popmsg></view>