<view class="container"><block qq:if="{{isload}}"><block><dd-tab vue-id="eecdac44-1" itemdata="{{['全部','待付款','已支付','已完成','退款']}}" itemst="{{['all','0','1','3','10']}}" st="{{st}}" isfixed="{{true}}" data-event-opts="{{[['^changetab',[['changetab']]]]}}" bind:changetab="__e" bind:__l="__l"></dd-tab><view style="width:100%;height:100rpx;"></view><view class="topsearch flex-y-center"><view class="f1 flex-y-center"><image class="img" src="{{pre_url+'/static/img/search_ico.png'}}"></image><input placeholder="输入关键字搜索" placeholder-style="font-size:24rpx;color:#C2C2C2" data-event-opts="{{[['confirm',[['searchConfirm',['$event']]]]]}}" value="{{keyword}}" bindconfirm="__e"/></view></view><view class="order-content"><block qq:for="{{$root.l1}}" qq:for-item="item" qq:for-index="index" qq:key="index"><block><view class="order-box" data-url="{{'shoporderdetail?id='+item.$orig.id}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" bindtap="__e"><view class="head"><view>{{"订单号："+item.$orig.ordernum}}</view><view class="flex1"></view><block qq:if="{{item.$orig.status==0}}"><text class="st0">待付款</text></block><block qq:if="{{item.$orig.status==1&&item.$orig.paytypeid!=4}}"><text class="st1">已付款</text></block><block qq:if="{{item.$orig.status==1&&item.$orig.paytypeid==4}}"><text class="st1">线下付款</text></block><block qq:if="{{item.$orig.status==3}}"><text class="st3">已完成</text></block><block qq:if="{{item.$orig.status==4}}"><text class="st4">已关闭</text></block></view><block qq:for="{{item.l0}}" qq:for-item="item2" qq:for-index="idx" qq:key="idx"><block><view class="content" style="{{(idx+1==item.$orig.procount?'border-bottom:none':'')}}"><view data-url="{{'/restaurant/shop/product?id='+item2.$orig.proid}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" catchtap="__e"><image src="{{item2.$orig.pic}}"></image></view><view class="detail"><text class="t1">{{item2.$orig.name}}</text><block qq:if="{{item2.$orig.ggtext&&item2.$orig.ggtext.length}}"><view class="flex-col"><block qq:for="{{item2.$orig.ggtext}}" qq:for-item="item3" qq:for-index="index"><block><text class="t2">{{item3}}</text></block></block></view></block><block qq:if="{{item2.$orig.ggname}}"><text class="t2">{{item2.$orig.ggname+(item2.$orig.jltitle?item2.$orig.jltitle:'')}}</text></block><view class="t3"><block qq:if="{{item2.$orig.jlprice}}"><text class="x1 flex1">{{"￥"+item2.g0}}</text></block><block qq:else><text class="x1 flex1">{{"￥"+item2.$orig.sell_price}}</text></block><text class="x2">{{"×"+item2.$orig.num}}</text></view><block qq:if="{{item2.$orig.remark}}"><text class="t2">{{"备注："+item2.$orig.remark}}</text></block></view></view></block></block><view class="bottom"><text>{{"共计"+item.$orig.procount+"个菜品 实付:￥"+item.$orig.totalprice}}</text><block qq:if="{{item.$orig.refund_status==1}}"><text style="color:red;">{{'退款中￥'+item.$orig.refund_money}}</text></block><block qq:if="{{item.$orig.refund_status==2}}"><text style="color:red;">{{'已退款￥'+item.$orig.refund_money}}</text></block><block qq:if="{{item.$orig.refund_status==3}}"><text style="color:red;">退款申请已驳回</text></block></view><block qq:if="{{item.$orig.mid}}"><view class="bottom flex-y-center"><image style="width:40rpx;height:40rpx;border-radius:50%;margin-right:10rpx;" src="{{item.$orig.member.headimg}}"></image><text style="font-weight:bold;color:#333;margin-right:8rpx;">{{item.$orig.member.nickname}}</text>{{"(ID:"+item.$orig.mid+')'}}</view></block></view></block></block></view><block qq:if="{{nomore}}"><nomore vue-id="eecdac44-2" bind:__l="__l"></nomore></block><block qq:if="{{nodata}}"><nodata vue-id="eecdac44-3" bind:__l="__l"></nodata></block></block></block><block qq:if="{{loading}}"><loading vue-id="eecdac44-4" bind:__l="__l"></loading></block></view>