<view class="wrap"><block s-if="{{isload}}"><block><block s-if="{{detail.kctype==1}}"><block><view class="title">{{detail.name}}</view><dp vue-id="6e037bb5-1" pagecontent="{{pagecontent}}"></dp><view style="margin-bottom:40rpx;"></view></block></block><block s-if="{{detail.kctype==2}}"><view class="audo-video"><view class="audoimg"><image src="{{detail.pic}}"></image></view><view class="play"><view class="play-left"><image hidden="{{!(playshow)}}" src="{{pre_url+'/static/img/video_icon.png'}}" data-event-opts="{{[['tap',[['play',['$event']]]]]}}" bindtap="__e"></image><image hidden="{{!(!playshow)}}" src="{{pre_url+'/static/img/play.png'}}" data-event-opts="{{[['tap',[['pauseaudio',['$event']]]]]}}" bindtap="__e"></image><text>{{nowtime}}</text></view><view class="play-right"><slider class="slider" block-size="16" min="{{0}}" max="{{time}}" value="{{currentTime}}" activeColor="#595959" data-event-opts="{{[['change',[['sliderChange',['$event']]]],['changing',[['sliderChanging',['$event']]]]]}}" bindchange="__e" bindchanging="__e"></slider></view><view class="play-end"><text>{{duration}}</text></view></view></view></block><block s-if="{{detail.kctype==3}}"><view class="videobox"><video class="video" id="video" autoplay="{{true}}" src="{{detail.video_url}}" initial-time="{{detail.startTime}}" data-event-opts="{{[['pause',[['pause',['$event']]]],['timeupdate',[['timeupdate',['$event']]]],['ended',[['ended',['$event']]]]]}}" bindpause="__e" bindtimeupdate="__e" bindended="__e"></video><block s-if="{{showspeed}}"><view class="speed"><block s-if="{{showspeed==1}}"><view data-event-opts="{{[['tap',[['setspeed',['$event']]]]]}}" class="t1" bindtap="__e">{{speedtext}}</view></block><block s-if="{{showspeed==2}}"><view class="f2"><block s-for="speedlist" s-for-item="item" s-for-index="index"><block><view class="{{['f22 '+(rate==item?'on':'')]}}" data-rate="{{item}}" data-event-opts="{{[['tap',[['bindButtonRate',['$event']]]]]}}" bindtap="__e"><text class="t2">{{item}}</text><text>X</text></view></block></block></view></block></view></block></view></block><view style="height:30rpx;width:100%;background-color:#f5f5f5;"></view><view class="content_box"><view class="title flex"><view class="t1">课程目录</view><block s-if="{{!detail.learnhg&&detail.isdt==1&&detail.count>=detail.kccount&&iskaoshi!=1}}"><view class="t2" data-url="{{'tiku?id='+detail.kcid}}" data-opentype="redirect" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" catchtap="__e">去答题</view></block><block s-if="{{iskaoshi==1}}"><view class="t2" data-url="{{'recordlog?kcid='+detail.kcid}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" catchtap="__e">答题记录</view></block></view><block s-for="datalist trackBy index" s-for-item="item" s-for-index="index"><view class="mulubox flex"><view class="left_box"><block s-if="{{item.kctype==1}}"><image src="{{pre_url+'/static/img/tw_icon.png'}}"></image></block><block s-if="{{item.kctype==2}}"><image src="{{pre_url+'/static/img/mp3_icon.png'}}"></image></block><block s-if="{{item.kctype==3}}"><image src="{{pre_url+'/static/img/video_icon.png'}}"></image></block></view><view class="right_box flex"><view class="{{['title_box '+(item.id==detail.id?'on':'')]}}" data-index="{{index}}" data-mianfei="{{item.ismianfei}}" data-url="{{'mldetail?id='+item.id+'&kcid='+detail.kcid}}" data-opentype="{{item.kctype==1?'redirect':'redirect'}}" data-study_status="{{item.study_status}}" data-record_status="{{item.record_status}}" data-event-opts="{{[['tap',[['todetail',['$event']]]]]}}" bindtap="__e"><view class="t1">{{''+item.name}}</view><view><block s-if="{{item.kctype==1}}"><text class="t2">图文课程</text></block><block s-if="{{item.kctype==2}}"><text class="t2">音频课程</text></block><block s-if="{{item.kctype==3}}"><text class="t2">视频课程</text></block><block s-if="{{item.video_duration>0}}"><text class="t2">{{'时长: '+item.duration}}</text></block></view></view><view><block s-if="{{item.jindu}}"><view class="jindu">{{item.jindu+(item.kctype==1&&item.jindu!='100'?'':'%')}}</view></block><block s-if="{{item.ismianfei&&!item.jindu}}"><view class="skbtn">试看</view></block><block s-if="{{detail.learnhg==1&&item.study_status==1}}"><block><block s-if="{{item.record_status==0&&item.tiku_status==1}}"><view class="skbtn" style="width:120rpx;height:50rpx;line-height:50rpx;padding:0rpx 20rpx;" data-index="{{index}}" data-study_status="{{item.study_status}}" data-record_status="{{item.record_status}}" data-url="{{'tiku?id='+detail.kcid+'&mlid='+item.id}}" data-opentype="redirect" data-event-opts="{{[['tap',[['totiku',['$event']]]]]}}" catchtap="__e">去答题</view></block><block s-if="{{item.record_status==1}}"><view class="skbtn" style="width:140rpx;background-color:#fff;border:2rpx solid #FC6D65;color:#FC6D65;height:50rpx;line-height:50rpx;padding:0rpx 20rpx;" data-url="{{'recordlog?kcid='+detail.kcid+'&mlid='+item.id}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" catchtap="__e">答题记录</view></block></block></block></view></view></view></block></view></block></block><block s-if="{{nomore}}"><nomore vue-id="6e037bb5-2" text="没有更多课程了"></nomore></block><block s-if="{{nodata}}"><nodata vue-id="6e037bb5-3" text="没有查找到相关课程"></nodata></block><block s-if="{{loading}}"><loading vue-id="6e037bb5-4"></loading></block><dp-tabbar vue-id="6e037bb5-5" opt="{{opt}}" data-event-opts="{{[['^getmenuindex',[['getmenuindex']]]]}}" bind:getmenuindex="__e"></dp-tabbar><popmsg class="vue-ref" vue-id="6e037bb5-6" data-ref="popmsg"></popmsg></view>