<view class="container"><block s-if="{{isload}}"><block><form data-event-opts="{{[['submit',[['formSubmit',['$event']]]]]}}" bindsubmit="__e"><view class="mymoney" style="{{'background:'+($root.m0)+';'}}"><view class="f1">{{"我的"+$root.m1}}</view><view class="f2"><text style="font-size:26rpx;"></text>{{userinfo.gold}}</view><view class="f1">{{"当前"+$root.m2+"价值："+set.gold_price}}</view><view class="f3" data-url="/pagesC/bonuspoolgold/goldlog" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" bindtap="__e"><text>{{$root.m3+"记录"}}</text><text class="iconfont iconjiantou" style="font-size:20rpx;"></text></view></view><view class="content2"><view class="item2"><view class="f1">购买金额(元)</view></view><view class="item3"><view class="f2"><input class="input" type="digit" name="buy_num" value="" placeholder="请输入购买金额" placeholder-style="color:#999;font-size:40rpx" data-event-opts="{{[['input',[['moneyinput',['$event']]]]]}}" bindinput="__e"/></view></view><block s-if="{{set.show_buy_fee==1}}"><view class="tips-box"><view class="item4 tips"><block s-if="{{set.bonuspool_gold_rate>0}}"><text>{{"购买手续费"+set.bonuspool_gold_rate+'%'}}</text></block></view></view></block></view><view class="withdrawtype"><view class="f1">选择支付方式：</view><view class="f2"><block s-for="$root.l0" s-for-item="item" s-for-index="index"><block><view class="item" data-paytype="{{item.$orig.type}}" data-event-opts="{{[['tap',[['changeradio',['$event']]]]]}}" catchtap="__e"><view class="t1">{{item.$orig.name}}<block s-if="{{item.$orig.type!='online'}}"><text>{{"(余额："+item.$orig.remain+")"}}</text></block></view><view class="radio" style="{{(paytype==item.$orig.type?'background:'+item.m4+';border:0':'')}}"><image class="radio-img" src="{{pre_url+'/static/img/checkd.png'}}"></image></view></view></block></block></view></view><button data-event-opts="{{[['tap',[['formSubmit',['$event']]]]]}}" class="btn" style="{{'background:'+($root.m5)+';'}}" bindtap="__e">立即购买</button></form><block s-if="{{set.desc}}"><view class="withdraw_desc"><view class="title">说明</view><textarea value="{{set.desc}}"></textarea></view></block></block></block><block s-if="{{loading}}"><loading vue-id="46e01667-1"></loading></block><dp-tabbar vue-id="46e01667-2" opt="{{opt}}"></dp-tabbar><popmsg class="vue-ref" vue-id="46e01667-3" data-ref="popmsg"></popmsg></view>