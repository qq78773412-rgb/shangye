<view class="container"><block s-if="{{isload}}"><block><view class="orderinfo"><view class="item"><text class="t1">订单编号</text><text class="t2">{{detail.ordernum}}</text></view><block s-if="{{detail.paynum}}"><view class="item"><text class="t1">支付流水</text><text class="t2">{{detail.paynum}}</text></view></block><block s-if="{{mendian}}"><view class="item"><text class="t1">付款门店</text><text class="t2">{{mendian.name}}</text></view></block><view class="item"><text class="t1">付款金额</text><text class="t2">{{"￥"+detail.money}}</text></view><view class="item"><text class="t1">实付金额</text><text class="t2" style="font-size:32rpx;color:#e94745;">{{"￥"+detail.paymoney}}</text></view><block s-if="{{detail.canrefund}}"><view class="item"><text class="t1">退款金额</text><text class="t2" style="color:#ff9b00;">{{"￥"+detail.refund_money}}</text></view></block><view class="item"><text class="t1">付款方式</text><text class="t2">{{detail.paytype}}</text></view><view class="item"><text class="t1">状态</text><block s-if="{{detail.status==1}}"><text class="t2" style="color:green;">已付款</text></block><block s-else><text class="t2" style="color:red;">未付款</text></block></view><block s-if="{{detail.status>0&&detail.paytime}}"><view class="item"><text class="t1">付款时间</text><text class="t2">{{detail.paytime}}</text></view></block><block s-if="{{detail.disprice>0}}"><view class="item"><text class="t1">{{$root.m0+"折扣"}}</text><text class="t2">{{"-￥"+detail.disprice}}</text></view></block><block s-if="{{detail.scoredk>0}}"><view class="item"><text class="t1">{{$root.m1+"抵扣"}}</text><text class="t2">{{"-￥"+detail.scoredk}}</text></view></block><block s-if="{{detail.couponrid}}"><view class="item"><text class="t1">{{$root.m2+"抵扣"}}</text><text class="t2">{{"-￥"+detail.couponmoney}}</text></view></block><block s-if="{{couponrecord}}"><view class="item"><text class="t1">{{$root.m3+"名称"}}</text><text class="t2">{{couponrecord.couponname}}</text></view></block><block s-if="{{dec_money}}"><view class="item"><text class="t1">{{$root.m4+"名称"}}</text><text class="t2">{{dec_money}}</text></view></block><block s-if="{{detail.dedamount_dkmoney&&detail.dedamount_dkmoney>0}}"><view class="item"><text class="t1">抵扣金</text><text class="t2">{{"-￥"+detail.dedamount_dkmoney}}</text></view></block><view class="item"><text class="t1">订单备注</text><text class="t2">{{detail.remark}}</text></view></view></block></block><block s-if="{{loading}}"><loading vue-id="88f35d0c-1"></loading></block><dp-tabbar vue-id="88f35d0c-2" opt="{{opt}}"></dp-tabbar><popmsg class="vue-ref" vue-id="88f35d0c-3" data-ref="popmsg"></popmsg></view>