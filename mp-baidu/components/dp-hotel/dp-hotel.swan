<view class="dp-kanjia" style="{{'background-color:'+(params.bgcolor)+';'+('margin:'+(params.margin_y*2.2+'rpx '+params.margin_x*2.2+'rpx 0')+';')+('padding:'+(params.padding_y*2.2+'rpx '+params.padding_x*2.2+'rpx')+';')}}"><view class="dp-hotel-item"><view class="hotels-list"><block s-for="$root.l0" s-for-item="item" s-for-index="index"><block><view class="hotels-options" data-url="{{'/hotel/index/hoteldetails?id='+item.$orig.hotelid}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" bindtap="__e"><view class="hotel-img"><image src="{{item.$orig.pic}}"></image></view><view class="hotel-info"><view class="hotel-title">{{item.$orig.name}}</view><view class="hotel-address">{{item.$orig.address}}</view><block s-if="{{item.$orig.tag.length>0}}"><view class="hotel-characteristic"><block s-for="item.$orig.tag" s-for-item="items" s-for-index="indexs"><block><view class="characteristic-options" style="{{('background:rgba('+item.m0+',0.05);color:'+item.m1)}}">{{items}}</view></block></block></view></block><view class="hotel-but-view"><view class="make-info"><block s-if="{{item.$orig.min_daymoney}}"><view class="hotel-price" style="{{'color:'+(item.m2)+';'}}"><view class="hotel-price-num">{{item.$orig.min_daymoney+item.m3}}</view><view>/晚起</view></view></block><block s-else><view class="hotel-price" style="{{'color:'+(item.m4)+';'}}"><view>￥</view><view class="hotel-price-num">{{item.$orig.sell_price}}</view><view>起</view></view></block><view class="hotel-text">{{item.$orig.sales+"人预定"}}</view></view><view class="hotel-make" style="{{('background:rgba('+$root.m5+',0.8);color:#FFF')}}">预约</view></view></view></view></block></block></view></view></view>