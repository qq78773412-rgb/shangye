<view class="dp-hotspot" style="{{'margin:'+(params.margin_y*2.2+'rpx '+params.margin_x*2.2+'rpx 0')+';'}}"><image class="image" src="{{params.imgurl}}" mode="widthFix"></image><block s-for="data trackBy item.id" s-for-item="item" s-for-index="index"><view data-event-opts="{{[['tap',[['gotoUrl',['$0','$1'],[[['data','id',item.id,'hrefurl']],'params']]]]]}}" class="hotarea" style="{{'width:'+(item.width*2.2+'rpx')+';'+('height:'+(item.height*2.2+'rpx')+';')+('left:'+(item.left*2.2+'rpx')+';')+('top:'+(item.top*2.2+'rpx')+';')}}" bindtap="__e"></view></block></view>