<view class="couponlist"><block s-for="$root.l0 trackBy index" s-for-item="item" s-for-index="index"><view class="coupon" style="{{(couponstyle)}}"><view class="{{[item.$orig.type==1?'pt_img1':'pt_img2']}}"></view><view class="pt_left" data-url="{{'/pagesExt/coupon/coupondetail?'+(choosecoupon?'rid':'id')+'='+item.$orig.id}}" data-event-opts="{{[['tap',[['goto',['$event']]]]]}}" bindtap="__e"><view class="pt_left-content"><block s-if="{{item.$orig.type==1}}"><view class="f1" style="{{'color:'+(item.m0)+';'}}"><text class="t0">￥</text><text class="t1">{{item.$orig.money}}</text></view></block><block s-if="{{item.$orig.type==10}}"><view class="f1" style="{{'color:'+(item.m1)+';'}}"><text class="t1">{{item.$orig.discount/10}}</text><text class="t0">折</text></view></block><block s-if="{{item.$orig.type==2}}"><view class="f1" style="{{'color:'+(item.m2)+';'}}">礼品券</view></block><block s-if="{{item.$orig.type==3}}"><view class="f1" style="{{'color:'+(item.m3)+';'}}"><text class="t1">{{item.$orig.limit_count}}</text><text class="t2">次</text></view></block><block s-if="{{item.$orig.type==4}}"><view class="f1" style="{{'color:'+(item.m4)+';'}}">抵运费</view></block><block s-if="{{item.$orig.type==11}}"><view class="f1" style="{{'color:'+(item.m5)+';'}}">兑换券</view></block><block s-if="{{item.$orig.type==5}}"><view class="f1" style="{{'color:'+(item.m6)+';'}}"><text class="t0">￥</text><text class="t1">{{item.$orig.money}}</text></view></block><block s-if="{{item.$orig.type==1||item.$orig.type==4||item.$orig.type==5||item.$orig.type==6}}"><view class="f2"><block s-if="{{item.$orig.minprice>0}}"><text>{{"满"+item.$orig.minprice+"元可用"}}</text></block><block s-else><text>无门槛</text></block></view></block></view></view><view class="pt_right"><view class="f1"><view class="t1">{{choosecoupon?item.$orig.couponname:item.$orig.name}}</view><view style="height:45rpx;"><block s-if="{{item.$orig.type==1}}"><text class="t2" style="{{'background:'+('rgba('+item.m7+',0.1)')+';'+('color:'+(item.m8)+';')}}">代金券</text></block><block s-if="{{item.$orig.type==2}}"><text class="t2" style="{{'background:'+('rgba('+item.m9+',0.1)')+';'+('color:'+(item.m10)+';')}}">礼品券</text></block><block s-if="{{item.$orig.type==3}}"><text class="t2" style="{{'background:'+('rgba('+item.m11+',0.1)')+';'+('color:'+(item.m12)+';')}}">计次券</text></block><block s-if="{{item.$orig.type==4}}"><text class="t2" style="{{'background:'+('rgba('+item.m13+',0.1)')+';'+('color:'+(item.m14)+';')}}">运费抵扣券</text></block><block s-if="{{item.$orig.type==5}}"><text class="t2" style="{{'background:'+('rgba('+item.m15+',0.1)')+';'+('color:'+(item.m16)+';')}}">餐饮券</text></block><block s-if="{{item.$orig.type==6}}"><text class="t2" style="{{'background:'+('rgba('+item.m17+',0.1)')+';'+('color:'+(item.m18)+';')}}">酒店券</text></block></view><view class="t3" style="item.bid>0?'margin-top:0':'margin-top:10rpx';">{{"有效期至 "+(choosecoupon?item.m19:item.m20)}}</view><block s-if="{{item.$orig.bid>0}}"><view class="t4">{{"适用商家："+item.$orig.bname}}</view></block></view><block s-if="{{choosecoupon}}"><block><block s-if="{{item.m21}}"><button class="btn" style="width:160rpx;background:#555;" data-rid="{{item.$orig.id}}" data-key="{{index}}" data-event-opts="{{[['tap',[['chooseCoupon',['$event']]]]]}}" bindtap="__e">取消选择</button></block><block s-else><button class="btn" style="{{'width:160rpx;'+('background:'+('linear-gradient(270deg,'+item.m22+' 0%,rgba('+item.m23+',0.8) 100%)')+';')}}" data-rid="{{item.$orig.id}}" data-key="{{index}}" data-event-opts="{{[['tap',[['chooseCoupon',['$event']]]]]}}" bindtap="__e">选择使用</button></block></block></block><block s-else><block><block s-if="{{item.$orig.haveget>=item.$orig.perlimit}}"><button class="btn" style="background:#9d9d9d;">已领取</button></block><block s-else><block s-if="{{item.$orig.stock<=0}}"><button class="btn" style="background:#9d9d9d;">已抢光了</button></block><block s-else><button class="btn" style="{{'background:'+('linear-gradient(270deg,'+item.m24+' 0%,rgba('+item.m25+',0.8) 100%)')+';'}}" data-id="{{item.$orig.id}}" data-price="{{item.$orig.price}}" data-score="{{item.$orig.score}}" data-key="{{index}}" data-event-opts="{{[['tap',[['getcoupon',['$event']]]]]}}" bindtap="__e">领取</button></block></block></block></block></view></view></block></view>