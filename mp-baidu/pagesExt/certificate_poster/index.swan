<view class="container"><block s-if="{{isload}}"><block><block s-if="{{set.header_text}}"><view><parse vue-id="7ee499aa-1" content="{{set.header_text}}"></parse></view></block><form style="width:100%;margin:10rpx;" report-submit="true" data-event-opts="{{[['submit',[['subconfirm',['$event']]]]]}}" bindsubmit="__e"><view class="title">{{"请输入身份证号查询"+certificate_text}}</view><view class="inputdiv"><input id="dhcode" type="text" name="tel" placeholder-style="color:#666;" placeholder="请输入您的身份证号" value="{{tel}}"/></view><button class="btn" form-type="submit">查询</button></form><block s-if="{{set.footer_text}}"><view><parse vue-id="7ee499aa-2" content="{{set.footer_text}}"></parse></view></block></block></block><block s-if="{{loading}}"><loading vue-id="7ee499aa-3"></loading></block><dp-tabbar vue-id="7ee499aa-4" opt="{{opt}}"></dp-tabbar><popmsg class="vue-ref" vue-id="7ee499aa-5" data-ref="popmsg"></popmsg></view>